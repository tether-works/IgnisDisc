<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CdBurner.Lithography</RootNamespace>
    <AssemblyName>CdBurner.Lithography</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ported\DiscImageStudio\Presets\built-in-disc-presets.json"
                      LogicalName="CdBurner.Lithography.Presets.BuiltInDiscPresets.json" />
    <EmbeddedResource Include="Ported\DiscImageStudio\Dvd\dispersion-byte-pools.json"
                      LogicalName="CdBurner.Lithography.Dvd.DispersionBytePools.json" />
    <EmbeddedResource Include="Ported\DiscImageStudio\Calibration\Patterns\target_slim.gray.gz"
                      LogicalName="CdBurner.Lithography.Calibration.target_slim.gray.gz" />
    <EmbeddedResource Include="Fonts\Spleen\spleen-5x8.bdf"
                      LogicalName="CdBurner.Lithography.Fonts.Spleen.spleen-5x8.bdf" />
    <EmbeddedResource Include="Fonts\Spleen\LICENSE"
                      LogicalName="CdBurner.Lithography.Fonts.Spleen.LICENSE" />
    <EmbeddedResource Include="Fonts\Unifont\unifont.hex.gz"
                      LogicalName="CdBurner.Lithography.Fonts.Unifont.unifont.hex.gz" />
    <EmbeddedResource Include="Fonts\Unifont\OFL.txt"
                      LogicalName="CdBurner.Lithography.Fonts.Unifont.OFL.txt" />
    <EmbeddedResource Include="Rosetta\Presets\rosetta-cell-presets.json"
                      LogicalName="CdBurner.Lithography.Rosetta.Presets.rosetta-cell-presets.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The picture-disc builder (DiscArt) lays files out with the Core ISO/UDF planner. Core does not reference this project. -->
    <ProjectReference Include="..\CdBurner.Core\CdBurner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ported encoders are internal; their tests check tables and sector layouts directly. -->
    <InternalsVisibleTo Include="CdBurner.Lithography.Tests" />
    <InternalsVisibleTo Include="CdBurner.Integration.Tests" />
  </ItemGroup>

</Project>
