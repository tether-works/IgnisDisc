<UserControl x:Class="CdBurner.App.Controls.BurnTelemetryChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BurnTelemetryMonitor}"
             Background="Transparent"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="130" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Telemetry header & dual-buffer bars -->
            <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                <TextBlock Text="LIVE BURN TELEMETRY"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="Speed:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding CurrentSpeedText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="Drive Buf:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" />
                    <ProgressBar Width="56" Height="6" Minimum="0" Maximum="100"
                                 Value="{Binding DeviceBufferBarValue, Mode=OneWay}"
                                 Foreground="{DynamicResource CapacitySafeBrush}"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 AutomationProperties.Name="Drive Buffer Fill"
                                 VerticalAlignment="Center"
                                 Margin="0,0,4,0" />
                    <TextBlock Text="{Binding DeviceBufferText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CapacitySafeBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="Host I/O Buf:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" />
                    <ProgressBar Width="56" Height="6" Minimum="0" Maximum="100"
                                 Value="{Binding HostBufferBarValue, Mode=OneWay}"
                                 Foreground="{DynamicResource CapacityWarningBrush}"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 AutomationProperties.Name="Host I/O Buffer Fill"
                                 VerticalAlignment="Center"
                                 Margin="0,0,4,0" />
                    <TextBlock Text="{Binding HostBufferText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CapacityWarningBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LBA:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding CurrentLbaText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </WrapPanel>

            <!-- Row 1: Theme-aware vector plot canvas -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4">
                <Grid>
                    <Canvas x:Name="PlotCanvas" ClipToBounds="True">
                        <Line x:Name="GridH25" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" StrokeDashArray="2 3" />
                        <Line x:Name="GridH50" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" StrokeDashArray="2 3" />
                        <Line x:Name="GridH75" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" StrokeDashArray="2 3" />
                        <Polyline x:Name="HostBufferLine"
                                  Stroke="{DynamicResource CapacityWarningBrush}"
                                  StrokeThickness="1.5"
                                  StrokeDashArray="4 2"
                                  Fill="Transparent" />
                        <Polyline x:Name="DeviceBufferLine"
                                  Stroke="{DynamicResource CapacitySafeBrush}"
                                  StrokeThickness="1.75"
                                  Fill="Transparent" />
                        <Polyline x:Name="SpeedLine"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="2"
                                  Fill="Transparent" />
                    </Canvas>

                    <TextBlock x:Name="AxisSpeedMaxText"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="4,2,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="AxisBufferMaxText"
                               Text="100%"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,2,4,0"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="EmptyStateText"
                               Text="Sampling burn telemetry..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>
            </Border>

            <!-- Row 2: Legend & Export Burn Plot action -->
            <DockPanel Grid.Row="2" Margin="0,6,0,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="12" Height="2" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="Write Speed" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <Rectangle Width="12" Height="2" Fill="{DynamicResource CapacitySafeBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="Drive Buffer %" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <Rectangle Width="12" Height="2" Fill="{DynamicResource CapacityWarningBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="Host I/O Buffer %" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Content="Export Burn Plot (.svg/.json)"
                        AutomationProperties.Name="Export Burn Plot (.svg/.json)"
                        Command="{Binding ExportBurnPlotCommand}"
                        Padding="10,3"
                        FontSize="11" />
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
