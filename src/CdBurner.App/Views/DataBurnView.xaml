<UserControl x:Class="CdBurner.App.Views.DataBurnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:controls="clr-namespace:CdBurner.App.Controls"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DataBurnViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:FileSystemPresetToStringConverter x:Key="PresetToString" />

        <ObjectDataProvider x:Key="FileSystemPresets"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:FileSystemPreset" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Settings & Profiles Panel -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: El Torito Boot Configuration (Expander) -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: File Explorer Toolbar -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Compilation Tree DataGrid -->
                <RowDefinition Height="*" MinHeight="150" />
                <!-- Row 4: Bottom Action & Status Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: TOP SETTINGS & FILESYSTEM PROFILE CARD                             -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Volume Label -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,20,2">
                        <TextBlock Text="Volume Label:"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,8,0" />
                        <TextBox Width="200"
                                 AutomationProperties.Name="Volume Label"
                                 Text="{Binding VolumeLabel, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="32"
                                 VerticalAlignment="Center"
                                 Padding="6,4"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}" />
                    </StackPanel>

                    <!-- Filesystem Preset Profile -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                        <TextBlock Text="Filesystem Profile:"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="250"
                                  AutomationProperties.Name="Filesystem Profile"
                                  ItemsSource="{Binding Source={StaticResource FileSystemPresets}}"
                                  SelectedItem="{Binding SelectedFileSystemPreset}"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource PresetToString}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>

                <!-- Options Checkboxes: their own row, wrapping on narrow windows -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox Content="Close / Finalize Disc"
                              AutomationProperties.Name="Close / Finalize Disc"
                              IsChecked="{Binding CloseDisc}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <CheckBox Content="Verify After Burn"
                              AutomationProperties.Name="Verify After Burn"
                              IsChecked="{Binding VerifyAfterBurn}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <CheckBox Content="Direct drive commands (experimental)"
                              AutomationProperties.Name="Direct drive commands (experimental)"
                              IsChecked="{Binding UseDirectDriveCommands}"
                              ToolTip="Burn with IgnisDisc's own drive commands instead of the Windows writer, at a speed taken from the drive's own list for the disc, then read the disc back to check it. Covers blank CD-R, CD-RW, DVD-R, DVD-RW, DVD+R (single and dual layer), DVD+RW, DVD-RAM, and single-layer BD-R and BD-RE so far; other discs are burned by the Windows writer as before."
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <CheckBox Content="Streaming WRITE(12) (BD-RE)"
                              AutomationProperties.Name="Streaming WRITE(12) (BD-RE)"
                              IsChecked="{Binding StreamingWrite}"
                              IsEnabled="{Binding UseDirectDriveCommands}"
                              Visibility="{Binding IsOverwritableBdMedia, Converter={StaticResource BoolToVis}}"
                              ToolTip="Send WRITE(12) with the MMC-5 Streaming bit (0x80) on BD-RE to skip hardware defect-management read-after-write slowdown. Requires direct drive commands. Off by default."
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <CheckBox Content="Add SHA256SUMS"
                              AutomationProperties.Name="Add SHA256SUMS"
                              ToolTip="Adds a SHA256SUMS file to the disc root. Years from now, 'sha256sum -c SHA256SUMS' (Linux/macOS) or PowerShell can check every file without IgnisDisc."
                              IsChecked="{Binding WriteSha256Manifest}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <CheckBox Content="Add BLAKE3SUMS"
                              AutomationProperties.Name="Add BLAKE3SUMS"
                              ToolTip="Adds a BLAKE3SUMS file to the disc root. 'b3sum -c BLAKE3SUMS' (the official BLAKE3 tool) can check every file later. Can be used together with SHA256SUMS."
                              IsChecked="{Binding WriteBlake3Manifest}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <StackPanel Orientation="Vertical" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Fill empty space with a picture"
                                      AutomationProperties.Name="Fill empty space with a picture"
                                      IsChecked="{Binding FillWithPicture}"
                                      ToolTip="{Binding FillPictureNote}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            <TextBox AutomationProperties.Name="Fill picture path"
                                     Text="{Binding FillPicturePath, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding FillWithPicture, Converter={StaticResource BoolToVis}}"
                                     Width="260"
                                     Padding="6,2"
                                     Margin="0,0,8,0"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}" />
                            <Button Content="Picture..."
                                    AutomationProperties.Name="Choose the fill picture"
                                    Command="{Binding BrowseFillPictureCommand}"
                                    ToolTip="Choose the PNG picture drawn on the empty part of a DVD or BD" />
                        </StackPanel>
                        <TextBlock Text="{Binding FillPictureNote}"
                                   Visibility="{Binding FillWithPicture, Converter={StaticResource BoolToVis}}"
                                   TextWrapping="Wrap"
                                   MaxWidth="560"
                                   HorizontalAlignment="Left"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: EL TORITO BOOT CONFIGURATION EXPANDER                              -->
        <!-- ========================================================================= -->
        <Expander Grid.Row="1"
                  AutomationProperties.Name="El Torito Boot Configuration"
                  IsExpanded="{Binding IsBootableEnabled, Mode=TwoWay}"
                  Background="{DynamicResource CardBackgroundBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  BorderThickness="1"
                  Padding="12,8"
                  Margin="0,0,0,12">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Enable El Torito Bootable Disc (BIOS / UEFI Multi-Boot)"
                              AutomationProperties.Name="Enable El Torito Bootable Disc (BIOS / UEFI Multi-Boot)"
                              IsChecked="{Binding IsBootableEnabled, Mode=TwoWay}"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
                    <TextBlock Text="⚡ Master bootable recovery, OS installation, and diagnostic media"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Expander.Header>

            <Grid Margin="12,10,12,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- BIOS Boot Image -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="x86 BIOS Boot Image:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         AutomationProperties.Name="x86 BIOS Boot Image Path"
                         Text="{Binding BiosBootImagePath, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4"
                         Margin="0,4,8,4"
                         Background="{DynamicResource ControlBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource ControlBorderBrush}" />
                <Button Grid.Row="0" Grid.Column="2"
                        Content="📂 Browse..."
                        AutomationProperties.Name="Browse x86 BIOS Boot Image"
                        Command="{Binding BrowseBiosBootImageCommand}"
                        Margin="0,4" />

                <!-- UEFI Boot Image -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="EFI/UEFI Boot Image:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         AutomationProperties.Name="EFI/UEFI Boot Image Path"
                         Text="{Binding UefiBootImagePath, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4"
                         Margin="0,4,8,4"
                         Background="{DynamicResource ControlBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource ControlBorderBrush}" />
                <Button Grid.Row="1" Grid.Column="2"
                        Content="📂 Browse..."
                        AutomationProperties.Name="Browse EFI/UEFI Boot Image"
                        Command="{Binding BrowseUefiBootImageCommand}"
                        Margin="0,4" />
            </Grid>
        </Expander>

        <!-- ========================================================================= -->
        <!-- ROW 2: EXPLORER ACTION TOOLBAR                                            -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="6,6,0,0"
                Padding="12,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="&#x1F4C1;+ Add Files"
                        AutomationProperties.Name="Add Files"
                        Command="{Binding AddFilesCommand}"
                        ToolTip="Add individual files to current virtual folder"
                        Margin="0,2,6,2" />
                <Button Content="&#x1F4C2;+ Add Folder"
                        AutomationProperties.Name="Add Folder"
                        Command="{Binding AddFolderCommand}"
                        ToolTip="Add local directory and contents to compilation"
                        Margin="0,2,6,2" />
                <Button Content="&#x2795; New Folder"
                        AutomationProperties.Name="New Folder"
                        Command="{Binding CreateVirtualFolderCommand}"
                        ToolTip="Create virtual folder inside current directory"
                        Margin="0,2,6,2" />
                <Button Content="&#x274C; Remove"
                        AutomationProperties.Name="Remove"
                        Command="{Binding RemoveSelectedItemCommand}"
                        ToolTip="Remove selected item from compilation"
                        Margin="0,2,12,2" />
                <Button Content="&#x2B06;&#xFE0F; Up"
                        AutomationProperties.Name="Navigate Up"
                        Command="{Binding NavigateUpFolderCommand}"
                        ToolTip="Navigate up to parent folder"
                        Margin="0,2,12,2" />

                <!-- Breadcrumb Path -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                    <TextBlock Text="Folder:"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding CurrentFolderPath}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="Bold" />
                </StackPanel>

                <!-- Import Previous Session -->
                <Button Content="&#x1F4E5; Import Session"
                        AutomationProperties.Name="Import Session"
                        Command="{Binding ImportPreviousSessionCommand}"
                        ToolTip="Import previous session directory tree from optical media"
                        Margin="0,2,0,2" />
            </WrapPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 3: COMPILATION TREE / ITEMS DATAGRID                                  -->
        <!-- ========================================================================= -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                AllowDrop="True"
                Drop="OnFileDrop">
            <DataGrid ItemsSource="{Binding CurrentItems}"
                      AutomationProperties.Name="Data Compilation Items"
                      SelectedItem="{Binding SelectedItem}"
                      MouseDoubleClick="OnDataGridDoubleClick"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                      Background="Transparent"
                      RowBackground="Transparent"
                      AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- Icon + Name -->
                    <DataGridTemplateColumn Header="Name" Width="300">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,2">
                                    <TextBlock Text="{Binding IconGlyph}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Type Description -->
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding TypeDescription}"
                                        Width="160" />

                    <!-- Size -->
                    <DataGridTextColumn Header="Size"
                                        Binding="{Binding DisplaySize}"
                                        Width="120" />

                    <!-- Virtual Path -->
                    <DataGridTextColumn Header="Virtual Path"
                                        Binding="{Binding VirtualPath}"
                                        Width="200" />

                    <!-- Source File Path -->
                    <DataGridTextColumn Header="Source Location"
                                        Binding="{Binding SourcePath}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 4: BOTTOM ACTION & METRICS BAR                                        -->
        <!-- ========================================================================= -->
        <Border Grid.Row="4"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,6,6"
                Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Row: Master Actions (wraps cleanly on narrow windows) -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                        <TextBlock Text="Burn To:"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="240"
                                  AutomationProperties.Name="Burn To Optical Drive"
                                  ItemsSource="{Binding AvailableRecorders}"
                                  SelectedItem="{Binding SelectedRecorder}"
                                  ToolTip="Select the optical drive to burn this Data Disc to">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding VendorId}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Button Content="&#x1F4BE; Export ISO..."
                            AutomationProperties.Name="Export ISO"
                            Command="{Binding ExportIsoCommand}"
                            ToolTip="Compile and build ISO disc image to disk"
                            Margin="0,2,10,2" />
                    <Button Content="&#x1F6D1; Cancel Burn"
                            AutomationProperties.Name="Cancel Burn"
                            Command="{Binding CancelBurnCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            ToolTip="Cancel the ongoing burn and stop the drive"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            Margin="0,2,10,2"
                            MinWidth="110" />
                    <Button Content="&#x1F525; Burn to Disc"
                            AutomationProperties.Name="Burn to Disc"
                            Command="{Binding StartDataBurnCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTip="Burn compilation to selected optical recorder"
                            Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                            Margin="0,2,0,2"
                            MinWidth="120" />
                </WrapPanel>

                <!-- Second Row: File metrics, status line & progress bar -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalFilesCount, StringFormat='{}{0} file(s)'}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="|" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0" />
                        <TextBlock Text="{Binding CapacityUsedMbText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="|" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontStyle="Italic"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StatusMessage}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </WrapPanel>

                    <ProgressBar AutomationProperties.Name="Burn Progress"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding BurnProgress}"
                                 Margin="0,6,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Multi-layer discs only (DVD±R DL, BD DL, BDXL): what lands on each layer and where the drive
                     changes layer. Hidden for single-layer discs. -->
                <TextBlock Grid.Row="2"
                           Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           AutomationProperties.Name="Layer split preview"
                           Text="{Binding LayerSplitText, Mode=OneWay}"
                           ToolTip="Where this compilation lands on each layer of the disc. Windows' writer fills layer 0 first; reading slows briefly at a layer change.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Live dual-buffer & write-speed telemetry chart (visible during and after burns) -->
                <controls:BurnTelemetryChartControl Grid.Row="3"
                                                    DataContext="{Binding Telemetry}"
                                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,10,0,0" />
            </Grid>
        </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
