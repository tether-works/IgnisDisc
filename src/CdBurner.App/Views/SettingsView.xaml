<UserControl x:Class="CdBurner.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CdBurner.App.Resources"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             xmlns:core="clr-namespace:CdBurner.Core;assembly=CdBurner.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16" MaxWidth="800" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <!-- Row 0: Burning Defaults Card -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Directories & External Tools Card -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Appearance & System Card -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Online Services & Updates Card -->
                <RowDefinition Height="Auto" />
                <!-- Row 4: Action Buttons Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: BURNING DEFAULTS CARD                                             -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc UiSettingsOpticalBurningDefaults}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- Default Target Optical Drive -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{loc:Loc UiSettingsDefaultTargetOpticalDrive}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{loc:Loc UiSettingsDefaultTargetOpticalDrive2}"
                                  ItemsSource="{Binding AvailableRecorders}"
                                  SelectedItem="{Binding SelectedRecorder}"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding VendorId}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Default Write Speed Multiplier -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{loc:Loc UiSettingsDefaultWriteSpeed}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{loc:Loc UiSettingsDefaultWriteSpeed2}"
                                  ItemsSource="{Binding AvailableSpeeds}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding DefaultWriteSpeedMultiplier}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{loc:Loc UiSettingsRecommendedUsesTheFastestSpeedThe}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="10,0,0,0" />
                    </Grid>

                    <!-- Verify After Burn -->
                    <CheckBox Content="{loc:Loc UiSettingsAutomaticallyVerifyMediaAfterBurnCompletion}"
                              AutomationProperties.Name="{loc:Loc UiSettingsAutomaticallyVerifyMediaAfterBurnCompletion}"
                              IsChecked="{Binding VerifyAfterBurnByDefault}"
                              Margin="0,0,0,8" />

                    <!-- Strict verify -->
                    <CheckBox Content="{loc:Loc UiSettingsStrictVerifyForceEveryReadFrom}"
                              AutomationProperties.Name="{loc:Loc UiSettingsStrictVerifyForceEveryReadFrom}"
                              ToolTip="{loc:Loc UiSettingsOffTheCheckForcesTheDrive}"
                              IsChecked="{Binding StrictVerify}"
                              Margin="0,0,0,8" />

                    <!-- Direct drive commands for DVD-RW -->
                    <CheckBox Content="{loc:Loc UiSettingsUseDirectDriveCommandsForDVD}"
                              AutomationProperties.Name="{loc:Loc UiSettingsUseDirectDriveCommandsForDVD2}"
                              ToolTip="{loc:Loc UiSettingsOnTheBurnScreensTickDirect}"
                              IsChecked="{Binding DirectWritingForDvdRw}"
                              Margin="0,0,0,8" />

                    <!-- Eject After Burn -->
                    <CheckBox Content="{loc:Loc UiSettingsEjectOpticalDriveTrayWhenBurn}"
                              AutomationProperties.Name="{loc:Loc UiSettingsEjectOpticalDriveTrayWhenBurn}"
                              IsChecked="{Binding EjectAfterBurnByDefault}"
                              Margin="0,0,0,8" />

                    <!-- Completion notice -->
                    <CheckBox Content="{loc:Loc UiSettingsTellMeWhenABurnFinishes}"
                              AutomationProperties.Name="{loc:Loc UiSettingsTellMeWhenABurnFinishes2}"
                              IsChecked="{Binding NotifyWhenBurnFinishes}"
                              Margin="0,0,0,8" />

                    <!-- Buffer Underrun Protection -->
                    <CheckBox Content="{loc:Loc UiSettingsEnableBufferUnderrunProtectionBURNProof}"
                              AutomationProperties.Name="{loc:Loc UiSettingsEnableBufferUnderrunProtectionBURNProof}"
                              IsChecked="{Binding EnableBurnFreeByDefault}" />
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 1: DIRECTORIES & EXTERNAL TOOLS (1-CLICK INSTALL)                    -->
            <!-- ========================================================================= -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc UiSettingsStagingDirectoriesOptionalExternalTools}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- Temp Staging Directory -->
                    <TextBlock Text="{loc:Loc UiSettingsTemporaryScratchISOStagingDirectory}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox AutomationProperties.Name="{loc:Loc UiSettingsTemporaryScratchISOStagingDirectory2}"
                             Text="{Binding TempStagingDirectory, UpdateSourceTrigger=LostFocus}"
                             Padding="8,5"
                             Background="{DynamicResource ControlBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource ControlBorderBrush}"
                             Margin="0,0,0,12" />

                    <!-- FFmpeg Path + 1-Click Install -->
                    <TextBlock Text="{loc:Loc UiSettingsFFmpegTranscoderExecutablePathDVDVideo}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 AutomationProperties.Name="{loc:Loc UiSettingsFFmpegTranscoderExecutablePath}"
                                 Text="{Binding FfmpegExecutablePath, UpdateSourceTrigger=LostFocus}"
                                 Padding="8,5"
                                 VerticalAlignment="Center"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}" />
                        <Button Grid.Column="1"
                                Content="{loc:Loc UiSettingsInstallFFmpeg1ClickLGPL}"
                                AutomationProperties.Name="{loc:Loc UiSettingsInstallFFmpeg1ClickLGPL2}"
                                Command="{Binding InstallFfmpegCommand}"
                                ToolTip="{loc:Loc UiSettingsDownloadsTheOfficialLGPLWindowsBuild}"
                                Padding="12,5"
                                Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding FfmpegStatusText}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <!-- par2cmdline + 1-Click Install -->
                    <TextBlock Text="{loc:Loc UiSettingsPAR2ArchiveRecoveryToolPar2cmdline}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Par2StatusText}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                Content="{loc:Loc UiSettingsInstallPar21Click}"
                                AutomationProperties.Name="{loc:Loc UiSettingsInstallPar21Click2}"
                                Command="{Binding InstallPar2Command}"
                                ToolTip="{loc:Loc UiSettingsDownloadsPar2cmdlineTurboPar2ExeSHA}"
                                Padding="12,5"
                                Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 2: APPEARANCE & SYSTEM                                               -->
            <!-- ========================================================================= -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Loc UiSettingsAppearanceDiagnostics}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- Theme Selection -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{loc:Loc UiSettingsVisualThemeMode}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{loc:Loc UiSettingsVisualThemeMode2}"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding ThemeMode}"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <!-- UI language selection -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{loc:Loc UiSettingsUiLanguage}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{loc:Loc UiSettingsUiLanguageName}"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding UiLanguage}"
                                  VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{loc:Loc UiSettingsUiLanguageHint}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- Virtual Drive Simulator Toggle -->
                    <CheckBox Content="{loc:Loc UiSettingsEnableSoftwareDefinedVirtualOpticalDrive}"
                              AutomationProperties.Name="{loc:Loc UiSettingsEnableSoftwareDefinedVirtualOpticalDrive}"
                              IsChecked="{Binding EnableVirtualDrive}"
                              Margin="0,0,0,12" />

                    <!-- Windows Explorer Shell Integration Toggle (Opt-in, HKCU) -->
                    <CheckBox Content="{loc:Loc UiSettingsIntegrateWithWindowsExplorerContextMenus}"
                              AutomationProperties.Name="{loc:Loc UiSettingsWindowsExplorerShellIntegration}"
                              ToolTip="{loc:Loc UiSettingsOptInPerUserRegistrationUnder}"
                              IsChecked="{Binding EnableExplorerShellIntegration}"
                              Margin="0,0,0,12" />

                    <!-- Log Buffer Capacity -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{loc:Loc UiSettingsDiagnosticRingBufferCapacity}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1"
                                 AutomationProperties.Name="{loc:Loc UiSettingsDiagnosticRingBufferCapacity2}"
                                 Text="{Binding LogRingBufferCapacity, UpdateSourceTrigger=LostFocus}"
                                 Padding="8,5"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 3: ONLINE SERVICES & UPDATES                                         -->
            <!-- ========================================================================= -->
            <Border Grid.Row="3"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Loc UiSettingsOnlineServicesUpdates}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <CheckBox Content="{loc:Loc UiSettingsLookUpAudioCDAlbumTrack}"
                              AutomationProperties.Name="{loc:Loc UiSettingsLookUpAudioCDAlbumAnd}"
                              IsChecked="{Binding LookupMusicBrainzByDefault}"
                              ToolTip="{loc:Loc UiSettingsSendsOnlyTheDiscSTable}"
                              Margin="0,0,0,8" />

                    <CheckBox Content="{loc:Loc UiSettingsVerifyRippedAudioCDTracksAgainst}"
                              AutomationProperties.Name="{loc:Loc UiSettingsVerifyRippedAudioCDTracksAgainst}"
                              IsChecked="{Binding VerifyAccurateRipByDefault}"
                              ToolTip="{loc:Loc UiSettingsChecksExtractedTrackCRCsAgainstThe}"
                              Margin="0,0,0,8" />

                    <CheckBox Content="{loc:Loc UiSettingsVerifyRippedAudioCDTracksAgainst2}"
                              AutomationProperties.Name="{loc:Loc UiSettingsVerifyRippedAudioCDTracksAgainst3}"
                              IsChecked="{Binding VerifyCtdbByDefault}"
                              ToolTip="{loc:Loc UiSettingsOptInSendsTheDiscS}"
                              Margin="0,0,0,12" />

                    <!-- AccurateRip Drive Read-Offset Database -->
                    <StackPanel Margin="0,0,0,12">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="{loc:Loc UiSettingsAccurateRipDriveOffsets}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,10,2" />
                            <Button Content="{loc:Loc UiSettingsRefreshOffsetDatabase}"
                                    AutomationProperties.Name="{loc:Loc UiSettingsRefreshOffsetDatabase}"
                                    Command="{Binding RefreshOffsetDatabaseCommand}"
                                    Padding="12,5"
                                    Margin="0,2,10,2"
                                    ToolTip="{loc:Loc UiSettingsDownloadOrRefreshAccurateRipSDriveOffsets}" />
                            <TextBlock Text="{Binding OffsetDatabaseStatusText}"
                                       AutomationProperties.Name="{loc:Loc UiSettingsOffsetDatabaseStatus}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12" />
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc UiSettingsReadOffsetMode}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,2,8,2" />
                            <TextBlock Text="{Binding AudioReadOffsetSummaryText}"
                                       AutomationProperties.Name="{loc:Loc UiSettingsAudioReadOffsetMode}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12"
                                       Margin="0,2,10,2" />
                            <Button Content="{loc:Loc UiSettingsUseAutomatic}"
                                    AutomationProperties.Name="{loc:Loc UiSettingsUseAutomaticReadOffset}"
                                    Command="{Binding ClearAudioReadOffsetOverrideCommand}"
                                    Visibility="{Binding HasManualAudioReadOffsetOverride, Converter={StaticResource BoolToVis}}"
                                    Padding="10,3"
                                    FontSize="11.5" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Opt-in Checkbox -->
                    <CheckBox Content="{loc:Loc UiSettingsCheckForNewerVersionsAutomaticallyOn}"
                              AutomationProperties.Name="{loc:Loc UiSettingsCheckForNewerVersionsAutomaticallyOn2}"
                              IsChecked="{Binding CheckForUpdatesOnStartup}"
                              Margin="0,0,0,12" />

                    <!-- Manual check button and status -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{loc:Loc UiSettingsCheckForUpdatesNow}"
                                AutomationProperties.Name="{loc:Loc UiSettingsCheckForUpdatesNow}"
                                Command="{Binding CheckForUpdatesCommand}"
                                Padding="16,6"
                                Margin="0,0,12,0" />
                        <TextBlock Text="{Binding UpdateStatusMessage}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" />
                    </StackPanel>

                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static core:LegalBanner.Line1}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12" />
                            <TextBlock Text="{x:Static core:LegalBanner.Line2}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="Source Code &amp; Issues: https://github.com/tether-works/IgnisDisc"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10.5"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 4: ACTION BUTTONS FOOTER                                              -->
            <!-- ========================================================================= -->
            <DockPanel Grid.Row="4" LastChildFill="False">
                <TextBlock Text="{loc:Loc UiSettingsChangesAreSavedAutomatically}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           Margin="0,0,16,0" />

                <Button Content="{loc:Loc UiSettingsResetToDefaults}"
                        AutomationProperties.Name="{loc:Loc UiSettingsResetToDefaults}"
                        Command="{Binding ResetSettingsCommand}"
                        Padding="16,8"
                        Margin="0,0,16,0" />

                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" />
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
