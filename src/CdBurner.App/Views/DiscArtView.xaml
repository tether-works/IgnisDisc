<UserControl x:Class="CdBurner.App.Views.DiscArtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DiscArtViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:PngBytesToImageSourceConverter x:Key="PngToImage" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <converters:InverseBooleanConverter x:Key="Not" />
    </UserControl.Resources>

    <Grid Margin="16">
        <TabControl KeyboardNavigation.TabNavigation="Local"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedIndex="{Binding SelectedWorkspaceTab, Mode=TwoWay}"
                    AutomationProperties.Name="Disc Art workspace tabs">
            <TabItem Header="Picture Disc" Padding="12,6" FontSize="13">
                <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Controls -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
            <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                <TextBlock Text="1. Picture and disc" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Button Content="Open picture (PNG)..." Command="{Binding OpenPictureCommand}" HorizontalAlignment="Left"
                        AutomationProperties.Name="Open picture" />
                <TextBlock Text="{Binding PicturePath}" TextWrapping="Wrap" Margin="0,4,0,6"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="CD" GroupName="DiscArtMedium" IsChecked="{Binding IsCd}" Margin="0,0,12,0"
                                 AutomationProperties.Name="CD picture track" />
                    <RadioButton Content="DVD" GroupName="DiscArtMedium" IsChecked="{Binding IsDvd}" Margin="0,0,12,0"
                                 AutomationProperties.Name="DVD picture disc" />
                    <RadioButton Content="BD" GroupName="DiscArtMedium" IsChecked="{Binding IsBluRay}"
                                 AutomationProperties.Name="BD picture disc" />
                </StackPanel>
                <TextBlock Text="Disc preset or saved calibration" Margin="0,6,0,2" />
                <ComboBox ItemsSource="{Binding DiscChoices}" SelectedItem="{Binding SelectedDisc}"
                          AutomationProperties.Name="Disc preset or saved calibration" />

                <TextBlock Text="2. Placement" FontWeight="SemiBold" Margin="0,12,0,4" />
                <TextBlock Text="{Binding Scale, StringFormat=Scale {0:0.00}}" />
                <Slider Minimum="0.1" Maximum="4" Value="{Binding Scale}" SmallChange="0.01" LargeChange="0.1"
                        AutomationProperties.Name="Picture scale" />
                <TextBlock Text="{Binding OffsetXMm, StringFormat=Move right {0:0.0} mm}" />
                <Slider Minimum="-60" Maximum="60" Value="{Binding OffsetXMm}" SmallChange="0.5" LargeChange="5"
                        AutomationProperties.Name="Move picture right in millimetres" />
                <TextBlock Text="{Binding OffsetYMm, StringFormat=Move down {0:0.0} mm}" />
                <Slider Minimum="-60" Maximum="60" Value="{Binding OffsetYMm}" SmallChange="0.5" LargeChange="5"
                        AutomationProperties.Name="Move picture down in millimetres" />
                <TextBlock Text="{Binding RotationDegrees, StringFormat=Rotate clockwise {0:0} degrees}" />
                <Slider Minimum="-180" Maximum="180" Value="{Binding RotationDegrees}" SmallChange="1" LargeChange="15"
                        AutomationProperties.Name="Rotate picture clockwise in degrees" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox Content="Fit to the drawn ring" IsChecked="{Binding FitToRing}" Margin="0,0,12,0"
                              AutomationProperties.Name="Fit picture to the drawn ring" />
                    <Button Content="Reset" Command="{Binding ResetPlacementCommand}"
                            AutomationProperties.Name="Reset placement" />
                </StackPanel>
                <TextBlock Text="Drag the preview to move the picture; the mouse wheel scales it." TextWrapping="Wrap"
                           Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />

                <TextBlock Text="3. Tone" FontWeight="SemiBold" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Photo" Command="{Binding PhotoToneCommand}" Margin="0,0,6,0"
                            AutomationProperties.Name="Photo tone preset" />
                    <Button Content="Black and white" Command="{Binding BinaryToneCommand}"
                            AutomationProperties.Name="Black and white tone preset" />
                </StackPanel>
                <TextBlock Text="{Binding DitherStrength, StringFormat=Dither {0:0.00}}" Margin="0,6,0,0" />
                <Slider Minimum="0" Maximum="1" Value="{Binding DitherStrength}" SmallChange="0.05" LargeChange="0.25"
                        AutomationProperties.Name="Dither strength" />
                <TextBlock Text="{Binding Brightness, StringFormat=Brightness {0:+0;-0;0}}" />
                <Slider Minimum="-64" Maximum="64" Value="{Binding Brightness}" SmallChange="1" LargeChange="8"
                        AutomationProperties.Name="Brightness" />
                <CheckBox Content="sRGB linear light" IsChecked="{Binding SrgbLinearization}"
                          AutomationProperties.Name="sRGB linear light" />
                <CheckBox Content="Four grey levels (CD only)" IsChecked="{Binding FourLevels}" IsEnabled="{Binding IsCd}"
                          AutomationProperties.Name="Four grey levels" />
                <TextBlock Text="{Binding ToneSummary}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <StackPanel IsEnabled="{Binding CanCarryFiles}">
                    <TextBlock Text="4. Files and art band (DVD / BD)" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Files folder..." Command="{Binding ChooseFilesFolderCommand}" Margin="0,0,6,0"
                                AutomationProperties.Name="Choose files folder" />
                        <Button Content="No files" Command="{Binding ClearFilesFolderCommand}"
                                AutomationProperties.Name="Remove files folder" />
                    </StackPanel>
                    <TextBlock Text="{Binding FilesFolder}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <CheckBox Content="Files at the outer edge" IsChecked="{Binding FilesOuter}"
                              IsEnabled="{Binding HasFiles}" Margin="0,4,0,0"
                              AutomationProperties.Name="Files at the outer edge" />
                    <TextBlock Text="Volume label" Margin="0,6,0,2" />
                    <TextBox Text="{Binding VolumeLabel, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Volume label" />
                    <TextBlock Text="Art band, inner and outer radius in mm (empty: whole disc)" TextWrapping="Wrap" Margin="0,6,0,2" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding ArtInnerRadiusText, UpdateSourceTrigger=LostFocus}" Width="80" Margin="0,0,6,0"
                                 AutomationProperties.Name="Art band inner radius in millimetres" />
                        <TextBox Text="{Binding ArtOuterRadiusText, UpdateSourceTrigger=LostFocus}" Width="80"
                                 AutomationProperties.Name="Art band outer radius in millimetres" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,12,0,0" ToolTip="{Binding TitleRingToolTip}" ToolTipService.ShowOnDisabled="True">
                    <TextBlock Text="5. Title ring (DVD only)" FontWeight="SemiBold" Margin="0,0,0,4"
                               IsEnabled="{Binding CanDrawTitleRing}" />
                    <TextBlock Text="Title (empty: no title ring)" Margin="0,0,0,2"
                               IsEnabled="{Binding CanDrawTitleRing}" />
                    <TextBox Text="{Binding TitleRingText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanDrawTitleRing}"
                             ToolTip="{Binding TitleRingToolTip}"
                             ToolTipService.ShowOnDisabled="True"
                             AutomationProperties.Name="Title ring text" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Date (yyyy-MM-dd or none)" Margin="0,0,0,2"
                                       IsEnabled="{Binding CanDrawTitleRing}" />
                            <TextBox Text="{Binding TitleRingDateText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="140"
                                     IsEnabled="{Binding CanDrawTitleRing}"
                                     ToolTip="{Binding TitleRingToolTip}"
                                     ToolTipService.ShowOnDisabled="True"
                                     AutomationProperties.Name="Title ring date" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Height in mm (2 to 10)" Margin="0,0,0,2"
                                       IsEnabled="{Binding CanDrawTitleRing}" />
                            <TextBox Text="{Binding TitleRingHeightText, UpdateSourceTrigger=LostFocus}"
                                     Width="80"
                                     IsEnabled="{Binding CanDrawTitleRing}"
                                     ToolTip="{Binding TitleRingToolTip}"
                                     ToolTipService.ShowOnDisabled="True"
                                     AutomationProperties.Name="Title ring height in millimetres" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding TitleRingUnavailableReason}"
                               Visibility="{Binding CanDrawTitleRing, Converter={StaticResource InvBoolToVis}}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               AutomationProperties.Name="Title ring unavailable reason" />
                </StackPanel>

                <StackPanel Margin="0,12,0,0">
                    <StackPanel IsEnabled="{Binding IsCd}">
                        <TextBlock Text="6. Audio CD CUE and pre-gap (CD only)" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Audio CD CUE..." Command="{Binding ChooseBaseCueCommand}" Margin="0,0,6,0"
                                    AutomationProperties.Name="Choose audio CD CUE sheet" />
                            <Button Content="No CUE" Command="{Binding ClearBaseCueCommand}"
                                    AutomationProperties.Name="Remove audio CD CUE sheet" />
                        </StackPanel>
                        <TextBlock Text="{Binding BaseCuePath}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <CheckBox Content="Hide the picture in the pre-gap (experimental)"
                                  IsChecked="{Binding HidePictureInPreGap}"
                                  IsEnabled="{Binding CanUsePreGap}"
                                  Margin="0,6,0,0"
                                  ToolTip="{Binding PreGapWarning}"
                                  ToolTipService.ShowOnDisabled="True"
                                  AutomationProperties.Name="Hide the picture in the pre-gap (experimental)" />
                        <TextBlock Text="Pre-gap length in seconds (60 to 1200, default 300)" Margin="0,6,0,2"
                                   IsEnabled="{Binding CanEditPreGapSeconds}" />
                        <TextBox Text="{Binding PreGapSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" HorizontalAlignment="Left"
                                 IsEnabled="{Binding CanEditPreGapSeconds}"
                                 AutomationProperties.Name="Pre-gap length in seconds" />
                    </StackPanel>
                    <TextBlock Text="{Binding PreGapWarning}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource CapacityWarningBrush}"
                               AutomationProperties.Name="Pre-gap picture experimental warning" />
                </StackPanel>

                <TextBlock Text="7. Image and burn" FontWeight="SemiBold" Margin="0,12,0,4" />
                <TextBlock Text="{Binding OutputHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Save as..." Command="{Binding ChooseOutputCommand}" Margin="0,0,6,0"
                            AutomationProperties.Name="Choose image file" />
                </StackPanel>
                <TextBlock Text="{Binding OutputPath}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Previews, actions and status -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Placement" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Border BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Background="Black">
                        <Image x:Name="DiscSurface" Width="360" Height="360" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" Cursor="SizeAll"
                               Source="{Binding PlacementPreviewPng, Converter={StaticResource PngToImage}}"
                               MouseLeftButtonDown="DiscSurface_MouseLeftButtonDown"
                               MouseMove="DiscSurface_MouseMove"
                               MouseLeftButtonUp="DiscSurface_MouseLeftButtonUp"
                               MouseWheel="DiscSurface_MouseWheel"
                               AutomationProperties.Name="Placement preview" />
                    </Border>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Read back from the image" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Border BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Background="Black">
                        <Image x:Name="ReadbackSurface" Width="360" Height="360" Stretch="Uniform"
                               Source="{Binding ReadbackPreviewPng, Converter={StaticResource PngToImage}}"
                               AutomationProperties.Name="Read-back preview of the generated image" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{Binding PlanSummary}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Generate image" Command="{Binding GenerateCommand}" Margin="0,0,6,0"
                            AutomationProperties.Name="Generate picture disc image" />
                    <Button Content="Burn..." Command="{Binding BurnCommand}" Margin="0,0,6,0"
                            AutomationProperties.Name="Burn picture disc image" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            AutomationProperties.Name="Cancel generating" />
                </StackPanel>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Rosetta Text Archive" Padding="12,6" FontSize="13">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column: medium, Rosetta presets, archive inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                        <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                            <TextBlock Text="1. Medium and disc geometry" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="DVD-R" GroupName="RosettaMedium" IsChecked="{Binding IsDvd}" Margin="0,0,12,0"
                                             ToolTip="{Binding RosettaMediaAdvice}"
                                             AutomationProperties.Name="Rosetta DVD-R medium" />
                                <RadioButton Content="CD-R" GroupName="RosettaMedium" IsChecked="{Binding IsCd}" Margin="0,0,12,0"
                                             ToolTip="{Binding RosettaMediaAdvice}"
                                             AutomationProperties.Name="Rosetta CD-R medium" />
                                <RadioButton Content="BD-R" GroupName="RosettaMedium" IsChecked="{Binding IsBluRay}"
                                             ToolTip="{Binding RosettaMediaAdvice}"
                                             AutomationProperties.Name="Rosetta BD-R medium" />
                            </StackPanel>
                            <TextBlock Text="Disc preset or saved calibration" Margin="0,6,0,2" />
                            <ComboBox ItemsSource="{Binding DiscChoices}" SelectedItem="{Binding SelectedDisc}"
                                      AutomationProperties.Name="Rosetta disc geometry" />

                            <TextBlock Text="2. Rosetta glyph-cell preset" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <RadioButton Content="{Binding RosettaHobbyistLabel}"
                                         GroupName="RosettaPreset"
                                         IsChecked="{Binding IsRosettaHobbyistSelected}"
                                         ToolTip="{Binding RosettaHobbyistToolTip}"
                                         ToolTipService.ShowOnDisabled="True"
                                         Margin="0,2,0,4"
                                         AutomationProperties.Name="Hobbyist Rosetta preset" />
                            <RadioButton Content="{Binding RosettaHighDensityLabel}"
                                         GroupName="RosettaPreset"
                                         IsChecked="{Binding IsRosettaHighDensitySelected}"
                                         IsEnabled="{Binding CanSelectRosettaHighDensity}"
                                         ToolTip="{Binding RosettaHighDensityToolTip}"
                                         ToolTipService.ShowOnDisabled="True"
                                         Margin="0,2,0,4"
                                         AutomationProperties.Name="High-density Rosetta preset" />
                            <RadioButton Content="{Binding RosettaExperimentalBluRayLabel}"
                                         GroupName="RosettaPreset"
                                         IsChecked="{Binding IsRosettaExperimentalBluRaySelected}"
                                         IsEnabled="{Binding CanSelectRosettaExperimentalBluRay}"
                                         ToolTip="{Binding RosettaExperimentalBluRayToolTip}"
                                         ToolTipService.ShowOnDisabled="True"
                                         Margin="0,2,0,4"
                                         AutomationProperties.Name="Experimental BD-R Rosetta preset" />
                            <TextBlock Text="{Binding RosettaStartingPointStatus}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource CapacityWarningBrush}"
                                       AutomationProperties.Name="Rosetta starting-point status" />
                            <TextBlock Text="{Binding RosettaPresetMicroscopeSummary}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       AutomationProperties.Name="Rosetta microscope guidance" />
                            <TextBlock Text="{Binding RosettaConstraintMessage}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource CapacityWarningBrush}"
                                       AutomationProperties.Name="Rosetta preset constraint message" />

                            <TextBlock Text="3. Archive text and layout" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <TextBlock Text="Archive title" Margin="0,0,0,2" />
                            <TextBox Text="{Binding RosettaTitle, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Rosetta archive title" />
                            <TextBlock Text="Archive date (yyyy-MM-dd)" Margin="0,6,0,2" />
                            <TextBox Text="{Binding RosettaDateText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="140" HorizontalAlignment="Left"
                                     AutomationProperties.Name="Rosetta archive date" />

                            <TextBlock Text="Text folder (.txt / .md, optional for capacity preview)" TextWrapping="Wrap" Margin="0,8,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Text folder..." Command="{Binding RosettaChooseTextFolderCommand}" Margin="0,0,6,0"
                                        AutomationProperties.Name="Choose Rosetta text folder" />
                                <Button Content="Clear" Command="{Binding RosettaClearTextFolderCommand}"
                                        AutomationProperties.Name="Clear Rosetta text folder" />
                            </StackPanel>
                            <TextBlock Text="{Binding RosettaTextFolder}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <StackPanel IsEnabled="{Binding IsDvd}">
                                <TextBlock Text="Extra vault files folder (optional, DVD-R only)" TextWrapping="Wrap" Margin="0,8,0,2" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Files folder..." Command="{Binding RosettaChooseFilesFolderCommand}" Margin="0,0,6,0"
                                            AutomationProperties.Name="Choose Rosetta files folder" />
                                    <Button Content="No files" Command="{Binding RosettaClearFilesFolderCommand}"
                                            AutomationProperties.Name="Clear Rosetta files folder" />
                                </StackPanel>
                                <TextBlock Text="{Binding RosettaFilesFolder}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Text="Pages inner radius in mm (default 38)" Margin="0,8,0,2" />
                            <TextBox Text="{Binding RosettaPagesInnerRadiusText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100" HorizontalAlignment="Left"
                                     AutomationProperties.Name="Rosetta pages inner radius in millimetres" />
                            <CheckBox Content="Include naked-eye rim header (title, date, SHA-256 prefix)"
                                      IsChecked="{Binding RosettaIncludeRimHeader}"
                                      Margin="0,6,0,0"
                                      AutomationProperties.Name="Include Rosetta rim header" />

                            <TextBlock Text="{Binding RosettaRedundancyPercent, StringFormat=Vault PAR2 redundancy: {0}%}" Margin="0,8,0,0" />
                            <Slider Minimum="0" Maximum="30" Value="{Binding RosettaRedundancyPercent}" SmallChange="5" LargeChange="10"
                                    IsSnapToTickEnabled="True" TickFrequency="5"
                                    IsEnabled="{Binding IsDvd}"
                                    AutomationProperties.Name="Rosetta PAR2 redundancy" />

                            <TextBlock Text="4. Image and burn (DVD-R)" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <Button Content="Save Rosetta .iso as..." Command="{Binding RosettaChooseOutputCommand}"
                                    HorizontalAlignment="Left" IsEnabled="{Binding IsDvd}"
                                    AutomationProperties.Name="Choose Rosetta output image" />
                            <TextBlock Text="{Binding RosettaOutputPath}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right column: live layout-computed capacity preview, media advice, actions -->
                    <StackPanel Grid.Column="1">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Layout-computed capacity preview" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding RosettaCapacitySummary}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           AutomationProperties.Name="Rosetta layout capacity preview" />
                                <TextBlock Text="{Binding RosettaVaultSummary}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           AutomationProperties.Name="Rosetta vault capacity preview" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Optical &amp; media advice (physics &amp; layout check)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding RosettaMediaAdvice}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           AutomationProperties.Name="Rosetta media advice" />
                                <TextBlock Text="{Binding RosettaMediumAvailabilityText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource CapacityWarningBrush}"
                                           AutomationProperties.Name="Rosetta medium availability" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Generate Rosetta ISO" Command="{Binding RosettaGenerateCommand}" Margin="0,0,6,0"
                                    AutomationProperties.Name="Generate Rosetta ISO" />
                            <Button Content="Burn..." Command="{Binding RosettaBurnCommand}" Margin="0,0,6,0"
                                    AutomationProperties.Name="Burn Rosetta ISO" />
                            <Button Content="Cancel" Command="{Binding CancelCommand}"
                                    AutomationProperties.Name="Cancel Rosetta generation" />
                        </StackPanel>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
