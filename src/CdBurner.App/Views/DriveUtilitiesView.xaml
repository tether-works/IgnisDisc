<UserControl x:Class="CdBurner.App.Views.DriveUtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:controls="clr-namespace:CdBurner.App.Controls"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DriveUtilitiesViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:RadioButtonBooleanConverter x:Key="RadioButtonBooleanConverter" />
        <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:SectorHealthStatusToBrushConverter x:Key="HealthToBrush" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Drive Selection Ribbon -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Section 1 & 2 (Inspector & Erase/Bitsetting side-by-side) -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Section 3 (Surface Scanner) -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Status & Progress Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: DRIVE SELECTION BAR                                               -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,10,2">
                            <TextBlock Text="Target Drive:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />

                            <ComboBox Width="250"
                                      AutomationProperties.Name="Target Drive"
                                      ItemsSource="{Binding AvailableRecorders}"
                                      SelectedItem="{Binding SelectedRecorder}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Button Content="&#x21BB; Refresh Capabilities"
                                AutomationProperties.Name="Refresh Capabilities"
                                Command="{Binding RefreshCapabilitiesCommand}"
                                Margin="0,2,8,2"
                                Padding="12,5" />
                        <Button Content="&#x1F4CB; Compatibility Report"
                                AutomationProperties.Name="Generate Compatibility Report"
                                Command="{Binding GenerateCompatibilityReportCommand}"
                                Margin="0,2,0,2"
                                Padding="12,5" />
                    </WrapPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 1: MMC INSPECTOR & ERASING / BITSETTING                               -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CARD 1: MMC Drive & Media Inspector -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="🔍 MMC Drive &amp; Media Inspector"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <!-- Device Geometry -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Hardware:" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold">
                                <Run Text="{Binding SelectedRecorder.VendorId, Mode=OneWay}" />
                                <Run Text="{Binding SelectedRecorder.ProductId, Mode=OneWay}" />
                                <Run Text=" Rev " />
                                <Run Text="{Binding SelectedRecorder.ProductRevision, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Media Type:" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding MediaDetails.MediaType, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Media ID / ATIP:" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MediaDetails.MediaManufacturerId, Mode=OneWay, TargetNullValue='N/A'}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding MediaDetails.MediaManufacturerId, Mode=OneWay}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Media Status:" Foreground="{DynamicResource TextMutedBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Blank: " Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding MediaDetails.IsBlank, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" />
                                <TextBlock Text="Rewritable: " Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding MediaDetails.IsRewritable, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sectors:" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="{Binding MediaDetails.TotalSectors, Mode=OneWay, StringFormat='{}{0:N0}'}" />
                                <Run Text=" total (" />
                                <Run Text="{Binding MediaDetails.FreeSectors, Mode=OneWay, StringFormat='{}{0:N0}'}" />
                                <Run Text=" free)" />
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Book Type:" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding MediaDetails.BookType, Mode=OneWay, TargetNullValue='N/A'}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>

                        <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,8,0,8" />

                        <!-- Write Capabilities Badges -->
                        <TextBlock Text="Write Capabilities:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                        <WrapPanel>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="CD-R" FontSize="11" Foreground="{Binding Capabilities.CanWriteCdR, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="CD-RW" FontSize="11" Foreground="{Binding Capabilities.CanWriteCdRw, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="DVD-R" FontSize="11" Foreground="{Binding Capabilities.CanWriteDvdR, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="DVD-RW" FontSize="11" Foreground="{Binding Capabilities.CanWriteDvdRw, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="DVD+R" FontSize="11" Foreground="{Binding Capabilities.CanWriteDvdPlusR, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="DVD+RW" FontSize="11" Foreground="{Binding Capabilities.CanWriteDvdPlusRw, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="DVD+R DL" FontSize="11" Foreground="{Binding Capabilities.CanWriteDvdPlusRDL, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="DVD-RAM" FontSize="11" Foreground="{Binding Capabilities.CanWriteDvdRam, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                        </WrapPanel>
                        <!-- MMC Recording Features Badges -->
                        <TextBlock Text="MMC Recording Features:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,6" />
                        <WrapPanel>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="TAO" FontSize="11" Foreground="{Binding Capabilities.SupportsNativeTao, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="SAO" FontSize="11" Foreground="{Binding Capabilities.SupportsNativeSao, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="Raw DAO" FontSize="11" Foreground="{Binding Capabilities.SupportsNativeRawDao, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="Test Write" FontSize="11" Foreground="{Binding Capabilities.SupportsTestWrite, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="BURN-Free" FontSize="11" Foreground="{Binding Capabilities.SupportsBufferUnderrunFree, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="Layer Jump" FontSize="11" Foreground="{Binding Capabilities.SupportsLayerJump, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 2: Rewritable Erase & DVD Book Type Bitsetting -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <!-- Erase Subsection -->
                        <TextBlock Text="🧹 Rewritable Disc Erase"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="Erase CD-RW, DVD-RW, DVD+RW, or DVD-RAM rewritable media."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,10" />

                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="Quick Erase (TOC / PMA Blank)"
                                         AutomationProperties.Name="Quick Erase (TOC / PMA Blank)"
                                         IsChecked="{Binding IsFullEraseSelected, Converter={StaticResource RadioButtonBooleanConverter}, ConverterParameter=False}"
                                         GroupName="EraseTypeGroup"
                                         Margin="0,2,16,2" />
                            <RadioButton Content="Full Erase (Complete Zero-Fill)"
                                         AutomationProperties.Name="Full Erase (Complete Zero-Fill)"
                                         IsChecked="{Binding IsFullEraseSelected, Converter={StaticResource RadioButtonBooleanConverter}, ConverterParameter=True}"
                                         GroupName="EraseTypeGroup"
                                         Margin="0,2,0,2" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Erase Rewritable Disc"
                                    AutomationProperties.Name="Erase Rewritable Disc"
                                    Command="{Binding EraseDiscCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    Padding="16,6"
                                    HorizontalAlignment="Left" />
                            <Button Content="🛑 Cancel"
                                    AutomationProperties.Name="Cancel Erase"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                    Padding="14,6"
                                    Margin="8,0,0,0" />
                        </StackPanel>

                        <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,12" />

                        <!-- Bitsetting Subsection -->
                        <TextBlock Text="🏷️ DVD Book Type Bitsetting"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="Change optical descriptor book type (e.g. DVD+R / DVD+R DL to DVD-ROM) for maximum legacy player compatibility."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                            <TextBlock Text="Target Book Type:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,10,2" />
                            <ComboBox Width="150"
                                      AutomationProperties.Name="Target Book Type"
                                      ItemsSource="{Binding AvailableBookTypes}"
                                      SelectedItem="{Binding SelectedBookType}"
                                      Margin="0,2,10,2" />
                            <Button Content="Apply Bitsetting"
                                    AutomationProperties.Name="Apply Bitsetting"
                                    Command="{Binding ApplyBookTypeCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    Margin="0,2,0,2"
                                    Padding="14,5" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- ROW 2: OPTICAL SECTOR SURFACE SCANNER & EXPERIMENTAL QUALITY SCAN         -->
            <!-- ========================================================================= -->
            <TabControl Grid.Row="2"
                        KeyboardNavigation.TabNavigation="Local"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="0,0,0,12"
                        AutomationProperties.Name="Drive scan workspaces">
                <TabItem Header="Surface Scanner &amp; Check Disc" Padding="12,6" FontSize="13">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Scanner Header & Controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="&#x1F52C; Sector Surface Scanner &amp; Transfer Benchmark"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Scans optical medium sectors, verifies ECC integrity, and identifies Slow or Damaged blocks."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="Check disc reads a CD once, as a player does, and says where it may click or skip."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding DiscHealthSummary}"
                                       AutomationProperties.Name="Disc check result"
                                       Visibility="{Binding HasDiscHealth, Converter={StaticResource BoolToVis}}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                                <TextBlock Text="Block Size (Sectors):"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />

                                <ComboBox Width="90"
                                          AutomationProperties.Name="Block Size (Sectors)"
                                          ItemsSource="{Binding AvailableBlockSizes}"
                                          SelectedItem="{Binding ScanBlockSizeSectors}"
                                          VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Content="Check disc"
                                    AutomationProperties.Name="Check disc"
                                    ToolTip="Reads every sector of the CD once with C2 error pointers and says where it may skip. Writes nothing."
                                    Command="{Binding CheckDiscCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    Padding="16,6"
                                    Margin="0,2,8,2" />
                            <Button Content="Start Surface Scan"
                                    AutomationProperties.Name="Start Surface Scan"
                                    Command="{Binding StartSurfaceScanCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    Padding="16,6"
                                    Margin="0,2,8,2"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource AccentForegroundBrush}" />
                            <Button Content="&#x1F4C8; Export Scan CSV"
                                    AutomationProperties.Name="Export Scan CSV"
                                    Command="{Binding ExportScanCsvCommand}"
                                    Padding="12,6"
                                    Margin="0,2,8,2" />
                            <Button Content="&#x1F6D1; Cancel Scan"
                                    AutomationProperties.Name="Cancel Scan"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                    Padding="14,6"
                                    Margin="0,2,0,2" />
                        </WrapPanel>
                    </Grid>

                    <!-- Progress Bar -->
                    <ProgressBar Grid.Row="1"
                                 AutomationProperties.Name="Scan Progress"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding OperationProgress}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Margin="0,0,0,12" />

                    <!-- Scan Metrics Pill Bar -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource RibbonBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SCANNED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding LatestScanReport.TotalSectorsScanned, StringFormat='{}{0:N0} LBAs', TargetNullValue='0 LBAs'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="GOOD BLOCKS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CapacitySafeBrush}" />
                                <TextBlock Text="{Binding LatestScanReport.GoodBlocks, TargetNullValue='0'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource CapacitySafeBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SLOW BLOCKS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CapacityWarningBrush}" />
                                <TextBlock Text="{Binding LatestScanReport.SlowBlocks, TargetNullValue='0'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource CapacityWarningBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="DAMAGED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CapacityOverburnBrush}" />
                                <TextBlock Text="{Binding LatestScanReport.DamagedBlocks, TargetNullValue='0'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource CapacityOverburnBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="AVG SPEED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding LatestScanReport.AverageSpeedKbPerSec, StringFormat='{}{0:F0} KiB/s', TargetNullValue='0 KiB/s'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="5">
                                <TextBlock Text="MAX SPEED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding LatestScanReport.MaxSpeedKbPerSec, StringFormat='{}{0:F0} KiB/s', TargetNullValue='0 KiB/s'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Visual Sector Surface Map Grid -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            MinHeight="180"
                            MaxHeight="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ScanBlocks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="12" Height="12"
                                                Margin="1"
                                                CornerRadius="2"
                                                Background="{Binding Status, Converter={StaticResource HealthToBrush}}">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding StartLba, StringFormat='Start LBA: {0:N0}'}" />
                                                        <TextBlock Text="{Binding SectorCount, StringFormat='Sectors: {0:N0}'}" />
                                                        <TextBlock Text="{Binding ReadSpeedKilobytesPerSec, StringFormat='Throughput: {0:F1} KiB/s'}" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Quality Scan (Experimental)" Padding="12,6" FontSize="13">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="16"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header + Experimental Notice -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Optical Error-Correction Quality Scan (C1/C2, PIE/PIF, LDC/BIS)"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border Background="{DynamicResource WarningBannerBackgroundBrush}"
                                        BorderBrush="{DynamicResource WarningBannerBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        Padding="8,5"
                                        Margin="0,6,0,6">
                                    <TextBlock Text="[ EXPERIMENTAL / UNVERIFIED ] Hardware MediaTek/Lite-On scans (0xF3/0xDF) are gated on the strict drive allow-list and remain experimental until verified against QPxTool on live discs."
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningBannerForegroundBrush}" />
                                </Border>
                                <TextBlock Text="{Binding QualityScanAllowListSummary}"
                                           AutomationProperties.Name="Quality scan allow-list status"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding QualityScanSummaryText}"
                                           AutomationProperties.Name="Quality scan result summary"
                                           Visibility="{Binding HasQualityScanReport, Converter={StaticResource BoolToVis}}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Controls -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                <Button Content="Run Quality Scan"
                                        AutomationProperties.Name="Run Quality Scan"
                                        Command="{Binding RunQualityScanCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource AccentForegroundBrush}"
                                        Padding="16,6"
                                        Margin="0,2,8,2" />
                                <CheckBox Content="Force legacy 0xDF (CD)"
                                          AutomationProperties.Name="Force legacy 0xDF"
                                          IsChecked="{Binding ForceLegacyQualityScan}"
                                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                          VerticalAlignment="Center"
                                          Margin="0,2,12,2" />
                                <Button Content="Export JSON"
                                        AutomationProperties.Name="Export Quality Scan JSON"
                                        Command="{Binding ExportQualityScanJsonCommand}"
                                        Padding="12,6"
                                        Margin="0,2,8,2" />
                                <Button Content="Export SVG"
                                        AutomationProperties.Name="Export Quality Scan SVG"
                                        Command="{Binding ExportQualityScanSvgCommand}"
                                        Padding="12,6"
                                        Margin="0,2,8,2" />
                                <Button Content="Cancel Quality Scan"
                                        AutomationProperties.Name="Cancel Quality Scan"
                                        Command="{Binding CancelCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        Padding="14,6"
                                        Margin="0,2,0,2" />
                            </WrapPanel>

                            <!-- Progress -->
                            <ProgressBar Grid.Row="2"
                                         Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding OperationProgress}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Margin="0,0,0,10" />

                            <!-- Summary KPI Strip -->
                            <Border Grid.Row="3"
                                    Background="{DynamicResource RibbonBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Padding="12,8"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="GRADE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding LatestQualityScanReport.Summary.Grade, TargetNullValue='NotEvaluated'}"
                                                   FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="PROTOCOL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding LatestQualityScanReport.Protocol, TargetNullValue='None'}"
                                                   FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SCANNED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding LatestQualityScanReport.Summary.TotalSectorsScanned, StringFormat='{}{0:N0}', TargetNullValue='0'}"
                                                   FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="PEAK C1/PIE/LDC" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding QualityScanPeakPrimaryText}"
                                                   FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="PEAK C2/PIF/BIS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CapacityOverburnBrush}" />
                                        <TextBlock Text="{Binding QualityScanPeakSecondaryText}"
                                                   FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource CapacityOverburnBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="5">
                                        <TextBlock Text="AVG SPEED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding LatestQualityScanReport.Summary.AverageSpeedX, StringFormat='{}{0:F1}x', TargetNullValue='0.0x'}"
                                                   FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Quality Scan Graph -->
                            <controls:QualityScanChartControl Grid.Row="4"
                                                              Samples="{Binding QualityScanSamples}"
                                                              MediaKind="{Binding QualityScanMediaKind}"
                                                              SamplesRevision="{Binding QualityScanSamplesRevision}"
                                                              IsExperimental="{Binding QualityScanIsExperimental}" />
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>
