<UserControl x:Class="CdBurner.App.Views.AudioBurnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:controls="clr-namespace:CdBurner.App.Controls"
             xmlns:local="clr-namespace:CdBurner.App.Views"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             xmlns:audio="clr-namespace:CdBurner.Core.Audio;assembly=CdBurner.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AudioBurnViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:AudioRecordingModeToBooleanConverter x:Key="RecordingModeConverter" />
    </UserControl.Resources>

    <Grid>
        <TabControl KeyboardNavigation.TabNavigation="Local" Background="Transparent" BorderThickness="0">
            <!-- ========================================================================= -->
            <!-- TAB 1: AUDIO CD MASTERING STUDIO                                         -->
            <!-- ========================================================================= -->
            <TabItem Header="&#x1F3B5; Audio CD Master" Padding="12,6" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <!-- Row 0: CD-Text Metadata & Recording Mode Card -->
                            <RowDefinition Height="Auto" />
                            <!-- Row 1: Duration Bar & Capacity Meter -->
                            <RowDefinition Height="Auto" />
                            <!-- Row 2: Track Actions Toolbar -->
                            <RowDefinition Height="Auto" />
                            <!-- Row 3: Tracks DataGrid; never squeezed below a few rows, so files can be dropped and seen -->
                            <RowDefinition Height="*" MinHeight="150" />
                            <!-- Row 4: Bottom Burn Bar -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                    <!-- ROW 0: CD-TEXT METADATA & RECORDING MODE -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,8"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Album Title -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Album Title:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     AutomationProperties.Name="Album Title"
                                     Text="{Binding AlbumTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}" />

                            <!-- Performer / Artist -->
                            <TextBlock Grid.Row="0" Grid.Column="3"
                                       Text="Performer:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Row="0" Grid.Column="4"
                                     AutomationProperties.Name="Performer"
                                     Text="{Binding AlbumPerformer, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}" />

                            <!-- Songwriter & UPC/EAN Sub-row -->
                            <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                                       Orientation="Horizontal"
                                       Margin="0,8,0,0"
                                       VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                                    <TextBlock Text="Songwriter:"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,8,0" />
                                    <TextBox Width="150"
                                             AutomationProperties.Name="Album Songwriter"
                                             Text="{Binding AlbumSongwriter, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,4"
                                             Background="{DynamicResource ControlBackgroundBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource ControlBorderBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,8,2">
                                    <TextBlock Text="UPC/EAN:"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,8,0" />
                                    <TextBox Width="120"
                                             AutomationProperties.Name="UPC/EAN"
                                             Text="{Binding UpcEanCode, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="15"
                                             Padding="6,4"
                                             ToolTip="{Binding UpcEanProblem, TargetNullValue='Catalog number written to the disc by direct drive commands: 13 digits (EAN-13) or 12 (UPC-A). Leave empty if you have none.'}"
                                             Background="{DynamicResource ControlBackgroundBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource ControlBorderBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding UpcEanProblem}"
                                           AutomationProperties.Name="UPC/EAN problem"
                                           Foreground="{DynamicResource CapacityWarningBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="320"
                                           VerticalAlignment="Center"
                                           Margin="0,2,0,2" />
                            </WrapPanel>

                            <!-- Recording Mode & DSP Options: a full-width row that wraps, so no option is cut off -->
                            <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                                       Orientation="Horizontal"
                                       Margin="0,8,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock Text="Mode:"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />
                                <RadioButton Content="Gapless DAO"
                                             AutomationProperties.Name="Gapless DAO"
                                             IsChecked="{Binding RecordingMode, Converter={StaticResource RecordingModeConverter}, ConverterParameter=DiscAtOnceGapless}"
                                             ToolTip="Disc-at-Once: the whole disc in one pass, with no forced 2-second gaps"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0" />
                                <RadioButton Content="TAO"
                                             AutomationProperties.Name="TAO"
                                             IsChecked="{Binding RecordingMode, Converter={StaticResource RecordingModeConverter}, ConverterParameter=TrackAtOnce}"
                                             ToolTip="Track-at-Once: 2-second link blocks between tracks"
                                             VerticalAlignment="Center"
                                             Margin="0,0,16,0" />

                                <CheckBox Content="Normalize Peaks"
                                          AutomationProperties.Name="Normalize Peaks"
                                          IsChecked="{Binding NormalizeAllTracks}"
                                          ToolTip="Apply -0.1 dBFS peak normalization across all audio tracks"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />

                                <CheckBox Content="Level Loudness (RMS)"
                                          AutomationProperties.Name="Level Loudness (RMS)"
                                          IsChecked="{Binding UseRmsLoudnessLeveling}"
                                          ToolTip="ReplayGain / EBU-style perceptual RMS loudness leveling (-14 dBFS) across all tracks"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />

                                <CheckBox Content="Loudness -18 LUFS"
                                          AutomationProperties.Name="Loudness -18 LUFS"
                                          IsChecked="{Binding NormalizeLoudness}"
                                          ToolTip="Bring tracks to -18 LUFS (ITU-R BS.1770-4) with a -1 dBTP true-peak limiter. Source files are not changed. Replaces RMS leveling when on."
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />

                                <CheckBox Content="Per album"
                                          AutomationProperties.Name="Loudness per album"
                                          IsChecked="{Binding LoudnessPerAlbum}"
                                          IsEnabled="{Binding NormalizeLoudness}"
                                          ToolTip="One gain for the whole disc instead of one per track, so quiet and loud tracks keep their difference."
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />

                                <CheckBox Content="Direct drive commands (experimental)"
                                          AutomationProperties.Name="Direct drive commands (experimental)"
                                          IsChecked="{Binding UseDirectDriveCommands}"
                                          ToolTip="Burn with IgnisDisc's own drive commands instead of the Windows writer. Writes CD-Text, ISRC and catalog codes, pre-emphasis flags and CUE gap marks, then reads the disc back to check it. Needs a blank CD-R or CD-RW and a drive that reports Session-at-Once."
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />

                                <CheckBox Content="Test write first"
                                          AutomationProperties.Name="Test write first"
                                          IsChecked="{Binding TestWriteFirst}"
                                          IsEnabled="{Binding UseDirectDriveCommands}"
                                          ToolTip="Run the whole burn with the laser off before the real one. Most drives then need the disc reloaded before they record it: the burn stops after the test, and you burn again with this switched off."
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />

                                <CheckBox Content="Recovery session (CD-Extra)"
                                          AutomationProperties.Name="Recovery session (CD-Extra)"
                                          IsChecked="{Binding IncludeRecoverySession}"
                                          ToolTip="Burn audio as session 1 and PAR2 recovery data over the disc's PCM as session 2. Off by default: requires direct drive commands and uses ~2.5 min of disc capacity; some car head units refuse Enhanced CDs."
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />

                                <Button Content="&#x1F4C1;+ Data Session (CD-Extra)..."
                                        AutomationProperties.Name="Choose Session 2 Data Folder"
                                        Command="{Binding BrowseDataSessionFolderCommand}"
                                        Padding="8,3"
                                        FontSize="11.5"
                                        ToolTip="Burn audio as session 1 and a folder of files as a Mode 1 ISO 9660 + Joliet session 2 (Enhanced CD). Requires direct drive commands."
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0" />

                                <Button Content="&#x2715; Clear Folder"
                                        AutomationProperties.Name="Clear Session 2 Data Folder"
                                        Command="{Binding ClearDataSessionFolderCommand}"
                                        Visibility="{Binding HasDataSessionFolder, Converter={StaticResource BoolToVis}}"
                                        Padding="8,3"
                                        FontSize="11.5"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0" />

                                <CheckBox Content="Blue Book layout"
                                          AutomationProperties.Name="Blue Book layout"
                                          IsChecked="{Binding BlueBookLayout}"
                                          Visibility="{Binding HasDataSessionFolder, Converter={StaticResource BoolToVis}}"
                                          ToolTip="Write session 2 as CD-ROM XA Mode 2 Form 1 with CDPLUS/INFO.CDP (album and track titles) and a PICTURES folder, for players and programs that look for an Enhanced CD. Off by default: Windows reads the normal Mode 1 session best."
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />

                                <CheckBox Content="Fill empty space with a picture"
                                          AutomationProperties.Name="Fill empty space with a picture"
                                          IsChecked="{Binding FillWithPicture}"
                                          ToolTip="{Binding FillPictureNote}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0" />

                                <Button Content="Picture..."
                                        AutomationProperties.Name="Choose the fill picture"
                                        Command="{Binding BrowseFillPictureCommand}"
                                        Visibility="{Binding FillWithPicture, Converter={StaticResource BoolToVis}}"
                                        Padding="8,3"
                                        FontSize="11.5"
                                        ToolTip="Choose the picture to draw. Without one, the cover art embedded in the music files is used, else cover.jpg or folder.jpg next to them."
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0" />

                                <Button Content="Automatic"
                                        AutomationProperties.Name="Use the automatic fill picture"
                                        Command="{Binding ClearFillPictureCommand}"
                                        Visibility="{Binding FillWithPicture, Converter={StaticResource BoolToVis}}"
                                        Padding="8,3"
                                        FontSize="11.5"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0" />

                                <TextBlock Text="{Binding FillPictureChoiceText}"
                                           Visibility="{Binding FillWithPicture, Converter={StaticResource BoolToVis}}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />

                                <CheckBox Content="Look up the cover online"
                                          AutomationProperties.Name="Look up the fill picture cover online"
                                          IsChecked="{Binding FillPictureLookupOnline}"
                                          Visibility="{Binding FillWithPicture, Converter={StaticResource BoolToVis}}"
                                          ToolTip="When the files have no cover art: look the album up on MusicBrainz by its title and artist and take the front cover from the Cover Art Archive. Off by default."
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />

                                <TextBlock Text="Crossfade (s):"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,6,0" />
                                <TextBox Width="42"
                                         AutomationProperties.Name="Crossfade (s)"
                                         Text="{Binding CrossfadeSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="4,2"
                                         TextAlignment="Center"
                                         ToolTip="Equal-power crossfade duration in seconds between adjacent tracks (0 = off)"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- ROW 1: DURATION BAR & CAPACITY METER -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock HorizontalAlignment="Left"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Total Duration: " Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Run Text="{Binding TotalDurationText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    <Run Text=" | " Foreground="{DynamicResource TextMutedBrush}" />
                                    <Run Text="{Binding TotalTracksText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="Capacity Used: " />
                                    <Run Text="{Binding DiscUsageText, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </Grid>

                            <ProgressBar Grid.Row="1"
                                         Height="8"
                                         AutomationProperties.Name="Disc Usage"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding DiscUsagePercent, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}" />

                            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                                <TextBlock AutomationProperties.Name="Session 2 data summary"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasDataSessionFolder, Converter={StaticResource BoolToVis}}"
                                           Text="{Binding DataSessionSummaryText, Mode=OneWay}"
                                           Margin="0,0,0,2" />
                                <TextBlock AutomationProperties.Name="Recovery session capacity"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding RecoverySessionCapacityText, Mode=OneWay}" />
                                <TextBlock AutomationProperties.Name="Recovery session compatibility warning"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding RecoverySessionWarningText, Mode=OneTime}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ROW 2: TRACK ACTIONS TOOLBAR -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="6,6,0,0"
                            Padding="12,8">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="&#x1F3B5;+ Add Audio / FLAC / CUE / Playlist..."
                                    AutomationProperties.Name="Add Audio / FLAC / CUE / Playlist"
                                    Command="{Binding AddAudioFilesCommand}"
                                    ToolTip="Add FLAC, WAV, MP3, M4A/AAC, OGG, WMA, CUE sheets, or M3U/M3U8/PLS playlists"
                                    Margin="0,2,6,2" />
                            <Button Content="&#x25B6;&#xFE0F; Preview"
                                    AutomationProperties.Name="Preview"
                                    Command="{Binding PreviewSelectedTrackCommand}"
                                    ToolTip="Listen to a Red Book preview of the selected track"
                                    Margin="0,2,4,2" />
                            <Button Content="&#x23F9;&#xFE0F; Stop"
                                    AutomationProperties.Name="Stop Preview"
                                    Command="{Binding StopPreviewCommand}"
                                    Visibility="{Binding IsPreviewPlaying, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Stop audio preview playback"
                                    Margin="0,2,8,2" />
                            <Button Content="&#x274C; Remove"
                                    AutomationProperties.Name="Remove"
                                    Command="{Binding RemoveTrackCommand}"
                                    ToolTip="Remove selected audio track"
                                    Margin="0,2,6,2" />
                            <Button Content="&#x1F5D1;&#xFE0F; Clear All"
                                    AutomationProperties.Name="Clear All"
                                    Command="{Binding ClearAllTracksCommand}"
                                    ToolTip="Remove all tracks from compilation"
                                    Margin="0,2,10,2" />
                            <Button Content="&#x2B06;&#xFE0F;"
                                    AutomationProperties.Name="Move Track Up"
                                    Command="{Binding MoveTrackUpCommand}"
                                    ToolTip="Move selected track earlier in sequence"
                                    Margin="0,2,4,2" />
                            <Button Content="&#x2B07;&#xFE0F;"
                                    AutomationProperties.Name="Move Track Down"
                                    Command="{Binding MoveTrackDownCommand}"
                                    ToolTip="Move selected track later in sequence"
                                    Margin="0,2,10,2" />
                            <Button Content="&#x1F5A8;&#xFE0F; Export Cover &amp; Tracklist..."
                                    AutomationProperties.Name="Export Cover &amp; Tracklist"
                                    Command="{Binding ExportCoverSheetCommand}"
                                    ToolTip="Generate a printable 120mm x 120mm CD Jewel Case Front Booklet, 150mm x 118mm Rear Tray Inlay, and Track Sheet"
                                    Margin="0,2,12,2" />

                            <TextBlock Text="FLAC, WAV, MP3, M4A, OGG, CUE, M3U/M3U8/PLS  &#x2192;  Red Book CD-DA"
                                       FontStyle="Italic"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,2,0,2" />
                        </WrapPanel>
                    </Border>

                    <!-- ROW 3: TRACKS DATAGRID -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <DataGrid ItemsSource="{Binding Tracks}"
                                      AutomationProperties.Name="Audio Tracks"
                                      SelectedItem="{Binding SelectedTrack}"
                                      AllowDrop="True"
                                      PreviewDragOver="OnPreviewDragOver"
                                      Drop="OnDrop"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                      Background="Transparent"
                                      RowBackground="Transparent"
                                      AlternatingRowBackground="{DynamicResource CardBackgroundBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#"
                                                        Binding="{Binding TrackNumber}"
                                                        Width="45"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Title"
                                                        Binding="{Binding Title}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="Performer / Artist"
                                                        Binding="{Binding Performer}"
                                                        Width="170" />
                                    <DataGridTextColumn Header="ISRC"
                                                        Binding="{Binding Isrc, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="Recording code written to the disc by direct drive commands, e.g. USRC17607839. Leave empty if you have none." />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasIsrcProblem}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource CapacityWarningBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="ToolTip" Value="{Binding IsrcProblem}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Format"
                                                        Binding="{Binding FormatSummary}"
                                                        Width="145"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Pre-Gap"
                                                        Binding="{Binding PreGapText}"
                                                        Width="85"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Duration"
                                                        Binding="{Binding DurationText}"
                                                        Width="95"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Size"
                                                        Binding="{Binding FileSizeFormatted}"
                                                        Width="85"
                                                        IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Header="Normalize"
                                                            Binding="{Binding NormalizeAudio}"
                                                            Width="75" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty-state overlay when no tracks are added -->
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Margin="24"
                                        Visibility="{Binding HasTracks, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Drop FLAC, WAV, MP3, M4A, OGG, WMA, or CUE files here"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Supports 16/24/32-bit lossless FLAC (44.1–192 kHz), single-file FLAC + CUE albums, Vorbis Comment tags, and folders — automatically decoded to Red Book 44.1 kHz 16-bit Stereo CD-DA."
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="640"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ROW 4: BOTTOM BURN & STATUS BAR -->
                    <Border Grid.Row="4"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,0,8,8"
                            Padding="16,10"
                            Margin="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                                    <TextBlock Text="Burn To:"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,8,0" />
                                    <ComboBox Width="250"
                                              AutomationProperties.Name="Burn To Optical Drive"
                                              ItemsSource="{Binding AvailableRecorders}"
                                              SelectedItem="{Binding SelectedRecorder}"
                                              ToolTip="Select the optical drive to burn this Audio CD to">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding VendorId}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <Button Content="&#x1F6D1; Cancel Burn"
                                        AutomationProperties.Name="Cancel Burn"
                                        Command="{Binding CancelBurnCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        ToolTip="Cancel ongoing burn and stop drive"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        Padding="18,10"
                                        FontSize="14"
                                        Margin="0,2,8,2" />
                                <Button Content="&#x1F525; Burn Audio CD"
                                        AutomationProperties.Name="Burn Audio CD"
                                        Command="{Binding StartAudioBurnCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                                        Padding="24,10"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Margin="0,2,0,2" />
                            </WrapPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding StatusMessage}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Height="6"
                                             AutomationProperties.Name="Burn Progress"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BurnProgress}"
                                             Margin="0,6,0,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <controls:BurnTelemetryChartControl Grid.Row="2"
                                                                DataContext="{Binding Telemetry}"
                                                                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                                                Margin="0,10,0,0" />
                        </Grid>
                    </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 2: AUDIO CD RIPPER (DIGITAL AUDIO EXTRACTION)                         -->
            <!-- ========================================================================= -->
            <TabItem Header="&#x1F4BF; Audio CD Ripper" Padding="12,6" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                    <!-- Ripper Destination Folder Card -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Output Folder:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Column="1"
                                     AutomationProperties.Name="Output Folder"
                                     Text="{Binding RipOutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="2"
                                    Content="📂 Browse..."
                                    AutomationProperties.Name="Browse Output Folder"
                                    Command="{Binding BrowseRipOutputFolderCommand}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Ripper Options & Accuracy Settings Card -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="420"
                                  Margin="0,0,0,12">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12">
                        <StackPanel>
                            <!-- Read Offset Row -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Read offset (samples):"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,10,0" />
                                <TextBox Grid.Column="1"
                                         AutomationProperties.Name="Read offset (samples)"
                                         Text="{Binding ReadOffsetSamples, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         Margin="0,0,8,0"
                                         ToolTip="Drive read offset correction in samples (-10000 to +10000) for sample-accurate ripping" />
                                <Button Grid.Column="2"
                                        Content="🔎 Detect"
                                        AutomationProperties.Name="Detect Read Offset"
                                        Command="{Binding DetectReadOffsetCommand}"
                                        VerticalAlignment="Center"
                                        ToolTip="Detect drive read offset using an inserted commercial Audio CD against AccurateRip" />
                            </Grid>

                            <!-- Output formats row -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Formats:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,12,0" />
                                <CheckBox Content="WAV"
                                          AutomationProperties.Name="Save as WAV"
                                          IsChecked="{Binding RipAsWav}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,16,2"
                                          ToolTip="Uncompressed WAV files. Needs nothing extra." />
                                <CheckBox Content="FLAC"
                                          AutomationProperties.Name="Save as FLAC"
                                          IsChecked="{Binding RipAsFlac}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,16,2"
                                          ToolTip="Lossless FLAC files. Uses the optional ffmpeg download." />
                                <CheckBox Content="MP3"
                                          AutomationProperties.Name="Save as MP3"
                                          IsChecked="{Binding RipAsMp3}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,16,2"
                                          ToolTip="MP3 files. Uses the optional ffmpeg download." />
                                <CheckBox Content="Opus"
                                          AutomationProperties.Name="Save as Opus"
                                          IsChecked="{Binding RipAsOpus}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,16,2"
                                          ToolTip="Opus files. Uses the optional ffmpeg download." />
                                <CheckBox Content="AAC"
                                          AutomationProperties.Name="Save as AAC"
                                          IsChecked="{Binding RipAsAac}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,0,2"
                                          ToolTip="AAC (.m4a) files made with the Windows AAC encoder. Needs nothing extra." />
                            </WrapPanel>

                            <!-- Quality row -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="MP3 quality:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,10,0" />
                                <ComboBox Width="210"
                                          AutomationProperties.Name="MP3 quality"
                                          ItemsSource="{Binding Mp3QualityChoices}"
                                          SelectedItem="{Binding SelectedMp3Quality}"
                                          IsEnabled="{Binding RipMp3Selected}"
                                          Margin="0,0,20,0"
                                          ToolTip="Constant bitrate or variable bitrate (VBR) for MP3 files. Available when MP3 is checked." />
                                <TextBlock Text="Opus/AAC bitrate (kbit/s):"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,10,0" />
                                <TextBox Width="70"
                                         AutomationProperties.Name="Opus and AAC bitrate in kilobits per second"
                                         Text="{Binding RipBitrateKbps, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding RipBitrateApplies}"
                                         Padding="8,6"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         ToolTip="Opus 6-510, AAC 96, 128, 160 or 192. Empty uses the default for the format. Available when Opus or AAC is checked." />
                            </WrapPanel>

                            <!-- Cover image row -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Cover image:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,10,0" />
                                <TextBox Grid.Column="1"
                                         AutomationProperties.Name="Cover image to embed in ripped files"
                                         Text="{Binding RipCoverArtPath, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         Margin="0,0,8,0"
                                         ToolTip="JPEG, PNG, GIF or WebP picture embedded as the front cover in FLAC and MP3 files. Empty embeds no cover." />
                                <Button Grid.Column="2"
                                        Content="Browse..."
                                        AutomationProperties.Name="Browse Cover Image"
                                        Command="{Binding BrowseRipCoverArtCommand}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                <Button Grid.Column="3"
                                        Content="Clear"
                                        AutomationProperties.Name="Clear Cover Image"
                                        Command="{Binding ClearRipCoverArtCommand}"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <!-- Library folder row -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Library folder:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,10,0" />
                                <TextBox Grid.Column="1"
                                         AutomationProperties.Name="Library folder"
                                         Text="{Binding RipLibraryFolder, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         Margin="0,0,8,0"
                                         ToolTip="Folder for the finished album, filed by artist and album. Empty saves the files in the output folder." />
                                <Button Grid.Column="2"
                                        Content="Browse..."
                                        AutomationProperties.Name="Browse Library Folder"
                                        Command="{Binding BrowseRipLibraryFolderCommand}"
                                        ToolTip="Choose the library folder"
                                        VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Empty: save in the output folder"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,10" />

                            <!-- File names row -->
                            <Grid Margin="0,0,0,2" IsEnabled="{Binding HasRipLibraryFolder}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="File names:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,10,0" />
                                <ComboBox Grid.Column="1"
                                          IsEditable="True"
                                          AutomationProperties.Name="File names template"
                                          ItemsSource="{Binding NamingTemplateChoices}"
                                          Text="{Binding RipNamingTemplate, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Tokens: {albumartist} {artist} {album} {year} {track} {title} {disc} {format}. Text in [square brackets] is left out when a token inside it is empty. Used when a library folder is set." />
                            </Grid>
                            <TextBlock Text="{Binding RipNamingPreview, StringFormat='Example: {0}'}"
                                       AutomationProperties.Name="File name example"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding RipNamingProblem}"
                                       AutomationProperties.Name="File names problem"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource CapacityOverburnBrush}"
                                       Margin="0,2,0,10" />

                            <!-- Cover and overwrite options -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox Content="Fetch cover art (Cover Art Archive)"
                                          AutomationProperties.Name="Fetch cover art (Cover Art Archive)"
                                          IsChecked="{Binding FetchCoverArt}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,20,2"
                                          ToolTip="Download the front cover from coverartarchive.org when MusicBrainz identifies the disc and no cover image is chosen above." />
                                <CheckBox Content="Save folder.jpg"
                                          AutomationProperties.Name="Save folder.jpg"
                                          IsChecked="{Binding WriteFolderImage}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,20,2"
                                          ToolTip="Save the cover as folder.jpg (or folder.png) in the album folder." />
                                <CheckBox Content="Replace existing files"
                                          AutomationProperties.Name="Replace existing files"
                                          IsChecked="{Binding OverwriteExistingFiles}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,0,2"
                                          ToolTip="Overwrite files that already exist at the destination. Off: the rip stops and keeps its WAV files." />
                            </WrapPanel>

                            <!-- Edition choice (shown when MusicBrainz lists several editions) -->
                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding HasReleaseChoice, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Edition:"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,10,0" />
                                    <ComboBox Grid.Column="1"
                                              AutomationProperties.Name="MusicBrainz edition of this disc"
                                              ItemsSource="{Binding ReleaseChoices}"
                                              SelectedIndex="{Binding SelectedReleaseIndex}"
                                              ToolTip="Several editions of this disc are listed on musicbrainz.org. Choose the one that matches your CD." />
                                </Grid>
                                <TextBlock Text="{Binding ReleaseDifferenceNote}"
                                           AutomationProperties.Name="How the editions differ"
                                           Visibility="{Binding HasReleaseDifferenceNote, Converter={StaticResource BoolToVis}}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- CheckBoxes -->
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox Content="Secure rip (C2 re-reads)"
                                          AutomationProperties.Name="Secure rip (C2 re-reads)"
                                          IsChecked="{Binding SecureRip}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,20,2"
                                          ToolTip="Use C2 error pointers to verify audio sectors and re-read corrupted samples." />
                                <CheckBox Content="Look up track names (MusicBrainz)"
                                          AutomationProperties.Name="Look up track names (MusicBrainz)"
                                          IsChecked="{Binding LookupMetadata}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,20,2"
                                          ToolTip="Fetch album and track titles from musicbrainz.org before ripping." />
                                <Button Content="Look up editions"
                                        AutomationProperties.Name="Look up editions"
                                        Command="{Binding LookUpReleasesCommand}"
                                        Padding="10,2"
                                        Margin="0,0,20,0"
                                        ToolTip="Read the disc's table of contents (no audio) and ask musicbrainz.org which editions of this disc exist, so you can choose yours before ripping." />
                                <CheckBox Content="Verify with AccurateRip"
                                          AutomationProperties.Name="Verify with AccurateRip"
                                          IsChecked="{Binding VerifyAccurateRip}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,20,2"
                                          ToolTip="Cross-reference extracted track checksums with the online AccurateRip database." />
                                <CheckBox Content="Verify with CTDB"
                                          AutomationProperties.Name="Verify with CTDB"
                                          IsChecked="{Binding VerifyCtdb}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,20,2"
                                          ToolTip="Opt-in: checks the ripped tracks against the online CUETools Database (db.cuetools.net). If the rip differs, IgnisDisc downloads the entry's repair data and keeps the fix only when AccurateRip confirms it." />
                                <CheckBox Content="Continue past unreadable sectors"
                                          AutomationProperties.Name="Continue past unreadable sectors"
                                          IsChecked="{Binding ContinueOnUnreadable}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,20,2"
                                          ToolTip="Zero-fill unreadable sectors with silence instead of aborting the rip." />
                                <CheckBox Content="Repair from recovery session"
                                          AutomationProperties.Name="Repair from recovery session"
                                          IsChecked="{Binding RepairFromRecoverySession}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,20,2"
                                          ToolTip="Verify ripped audio tracks against session 2 PAR2 recovery data on Enhanced CDs and rebuild any damaged samples." />
                                <CheckBox Content="De-emphasize pre-emphasis tracks"
                                          AutomationProperties.Name="De-emphasize pre-emphasis tracks"
                                          IsChecked="{Binding DeEmphasizePreEmphasisTracks}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,0,2"
                                          ToolTip="Apply the Red Book 50/15 us de-emphasis filter to tracks flagged with pre-emphasis so standalone files play with flat treble." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    </ScrollViewer>

                    <!-- Spacer / Ripper Results Card -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <!-- Ready Placeholder (Collapsed when RipReport has content) -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RipReport}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RipReport}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Ready for Digital Audio Extraction"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Select source optical drive below, configure destination directory, and click 'Rip Audio CD'."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>

                            <!-- Monospace Consolas Rip Report (Collapsed when empty) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <ScrollViewer.Style>
                                    <Style TargetType="{x:Type ScrollViewer}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RipReport}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RipReport}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <TextBox Text="{Binding RipReport, Mode=OneWay}"
                                         AutomationProperties.Name="Rip Report"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         Padding="4" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Bottom Rip Action Bar -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,10"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                                    <TextBlock Text="Rip From:"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,8,0" />
                                    <ComboBox Width="250"
                                              AutomationProperties.Name="Rip From Optical Drive"
                                              ItemsSource="{Binding AvailableRecorders}"
                                              SelectedItem="{Binding SelectedRecorder}"
                                              ToolTip="Select the optical drive containing the Audio CD to rip">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding VendorId}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <Button Content="&#x1F6D1; Cancel Rip"
                                        AutomationProperties.Name="Cancel Rip"
                                        Command="{Binding CancelBurnCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        ToolTip="Cancel ongoing audio extraction"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        Padding="18,10"
                                        FontSize="14"
                                        Margin="0,2,8,2" />
                                <Button Content="&#x1F4BF; Rip Audio CD"
                                        AutomationProperties.Name="Rip Audio CD"
                                        Command="{Binding RipAudioCdCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                                        Padding="24,10"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Margin="0,2,0,2" />
                            </WrapPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding StatusMessage}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Height="6"
                                             AutomationProperties.Name="Rip Progress"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BurnProgress}"
                                             Margin="0,6,0,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 3: CONVERT AUDIO FILES                                                -->
            <!-- ========================================================================= -->
            <TabItem Header="Convert Audio" Padding="12,6" FontSize="13">
                <local:AudioConvertView DataContext="{Binding Convert}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
