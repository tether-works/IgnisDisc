<UserControl x:Class="CdBurner.App.Views.ArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ArchiveViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- Row 0: Card 1 - Plan & Stage -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Card 2 - Discs -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Card 3 - Verify & Repair -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Footer - Status & Progress -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: CARD 1 - PLAN & STAGE                                             -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="📋 Plan &amp; Stage Archival Discs"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- Source Folder -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Source Folder:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" />
                        <TextBox Grid.Column="1"
                                 AutomationProperties.Name="Source Folder"
                                 Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 Padding="6,4"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}" />
                        <Button Grid.Column="2"
                                Content="Browse..."
                                AutomationProperties.Name="Browse Source Folder"
                                Command="{Binding BrowseSourceCommand}"
                                Margin="8,0,0,0"
                                Padding="12,4" />
                    </Grid>

                    <!-- Media & Redundancy -->
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <!-- Media selection -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,20,2">
                            <TextBlock Text="Media Type:"
                                       Width="130"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontWeight="SemiBold" />
                            <ComboBox Width="220"
                                      AutomationProperties.Name="Media Type"
                                      ItemsSource="{Binding MediaOptions}"
                                      SelectedItem="{Binding SelectedMedia}"
                                      DisplayMemberPath="Name"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Redundancy -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                            <TextBlock Text="Recovery Data:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,10,0" />
                            <Slider Width="160"
                                    AutomationProperties.Name="Minimum recovery data"
                                    ToolTip="The least recovery data each disc gets. Free space left on a disc is filled with more, so it survives more damage."
                                    Minimum="0"
                                    Maximum="30"
                                    Value="{Binding RedundancyPercent}"
                                    IsEnabled="{Binding Par2Available}"
                                    SmallChange="1"
                                    LargeChange="5"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="5"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RedundancyPercent, StringFormat='min {0}% PAR2'}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       Margin="8,0,0,0"
                                       MinWidth="60" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Par2 Status Text & 1-Click Install -->
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Par2StatusText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,2,10,2" />
                        <Button Content="⬇ Install par2 (1-Click)"
                                AutomationProperties.Name="Install par2 (1-Click)"
                                Command="{Binding InstallPar2Command}"
                                Visibility="{Binding IsPar2InstallOffered, Converter={StaticResource BoolToVis}}"
                                ToolTip="Downloads par2cmdline-turbo (par2.exe, SHA-256 checked) into %LOCALAPPDATA%\Programs\par2cmdline and enables PAR2 recovery data; replaces an older par2cmdline there"
                                Padding="10,3"
                                FontSize="11.5"
                                Margin="0,2,0,2"
                                VerticalAlignment="Center" />
                    </WrapPanel>

                    <!-- Opt-in RS03 Raw-Sector Parity -->
                    <StackPanel Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="Also generate RS03 raw-sector parity (opt-in; external dvdisaster interop unverified)"
                                      AutomationProperties.Name="Also generate RS03 raw-sector parity"
                                      IsChecked="{Binding UseRs03Parity}"
                                      ToolTip="PAR2 remains the primary mounted-filesystem default. Opt in to build standalone RS03 .ecc parity or an augmented write-once .iso alongside."
                                      Margin="0,2,16,2"
                                      VerticalAlignment="Center" />
                            <CheckBox Content="Augment .iso to disc capacity (write-once media only)"
                                      AutomationProperties.Name="Augment .iso to disc capacity"
                                      IsChecked="{Binding UseRs03AugmentedMode}"
                                      IsEnabled="{Binding UseRs03Parity}"
                                      ToolTip="Pads discNN.iso with RS03 layers to full CD/DVD/BD capacity. Avoid on rewritable media (DVD+RW, BD-RE), which can truncate past the filesystem boundary."
                                      Margin="0,2,16,2"
                                      VerticalAlignment="Center" />
                            <CheckBox Content="Allow augmented RS03 on rewritable media"
                                      AutomationProperties.Name="Allow augmented RS03 on rewritable media"
                                      IsChecked="{Binding AllowRewritableRs03Augmented}"
                                      Visibility="{Binding Rs03RewritableWarning, Converter={StaticResource NullToVis}}"
                                      Margin="0,2,0,2"
                                      VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Rs03RewritableWarning}"
                                   Visibility="{Binding Rs03RewritableWarning, Converter={StaticResource NullToVis}}"
                                   Foreground="#E6A100"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Staging Folder -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Staging Folder:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" />
                        <TextBox Grid.Column="1"
                                 AutomationProperties.Name="Staging Folder"
                                 Text="{Binding StagingFolder, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 Padding="6,4"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}" />
                        <Button Grid.Column="2"
                                Content="Browse..."
                                AutomationProperties.Name="Browse Staging Folder"
                                Command="{Binding BrowseStagingCommand}"
                                Margin="8,0,0,0"
                                Padding="12,4" />
                    </Grid>

                    <!-- Action Buttons & PlanSummary -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="📋 Plan"
                                AutomationProperties.Name="Plan"
                                Command="{Binding PlanCommand}"
                                Padding="16,6"
                                Margin="0,0,10,0"
                                FontWeight="SemiBold" />
                        <Button Grid.Column="1"
                                Content="📦 Stage discs"
                                AutomationProperties.Name="Stage discs"
                                Command="{Binding StageCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,6"
                                Margin="0,0,16,0"
                                FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding PlanSummary}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 1: CARD 2 - DISCS                                                    -->
            <!-- ========================================================================= -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                        <TextBlock Text="&#x1F4BF; Planned &amp; Staged Discs"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,2,20,2" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                            <TextBlock Text="Target Burner:"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />

                            <ComboBox Width="250"
                                      AutomationProperties.Name="Target Burner Drive"
                                      ItemsSource="{Binding AvailableRecorders}"
                                      SelectedItem="{Binding SelectedRecorder}"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <CheckBox Content="Verify after burning"
                                  AutomationProperties.Name="Verify after burning"
                                  IsChecked="{Binding VerifyAfterBurn}"
                                  VerticalAlignment="Center"
                                  Margin="0,2,16,2" />

                        <CheckBox Content="Direct drive commands (experimental)"
                                  AutomationProperties.Name="Direct drive commands (experimental)"
                                  IsChecked="{Binding UseDirectDriveCommands}"
                                  ToolTip="Burn each disc with IgnisDisc's own drive commands instead of the Windows writer, at a speed taken from the drive's own list for the disc, then read the disc back to check it. Covers blank CD-R, CD-RW, DVD-R, DVD-RW, DVD+R (single and dual layer), DVD+RW, DVD-RAM, and single-layer BD-R and BD-RE so far; other discs are burned by the Windows writer as before."
                                  VerticalAlignment="Center"
                                  Margin="0,2,16,2" />

                        <CheckBox Content="Set DVD+R/+R DL Book Type to DVD-ROM when supported"
                                  AutomationProperties.Name="Set DVD+R/+R DL Book Type to DVD-ROM when supported"
                                  IsChecked="{Binding SetDvdRomBookTypeWhenSupported}"
                                  ToolTip="Before burning DVD+R or DVD+R DL media, attempt to set its Book Type to DVD-ROM for better compatibility with legacy DVD players. Unsupported drives report cleanly without failing the burn."
                                  VerticalAlignment="Center"
                                  Margin="0,2,0,2" />
                    </WrapPanel>

                    <!-- Discs List -->
                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4"
                            MinHeight="100"
                            MaxHeight="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Discs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DiscNumber, StringFormat='Disc {0:D2}'}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Text="·" Margin="0,0,8,0" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding FileCount, StringFormat='{}{0:N0} files'}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Text="·" Margin="0,0,8,0" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding SizeText}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Text="·" Margin="0,0,8,0" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding Status}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding StagedPath, StringFormat=' ({0})'}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="11"
                                                               Visibility="{Binding StagedPath, Converter={StaticResource NullToVis}}"
                                                               Margin="8,0,0,0" />
                                                </StackPanel>

                                                <Button Grid.Column="1"
                                                        Content="🔥 Burn"
                                                        AutomationProperties.Name="Burn Disc"
                                                        Command="{Binding DataContext.BurnDiscCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="14,4"
                                                        Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 2: CARD 3 - VERIFY & REPAIR                                          -->
            <!-- ========================================================================= -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🔍 Verify &amp; Repair Archive Discs"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- Verify Path -->
                    <Grid Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Verify Path:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 AutomationProperties.Name="Verify Path"
                                 Text="{Binding VerifyPath, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 Padding="6,4"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}" />
                        <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Browse..."
                                    AutomationProperties.Name="Browse Verify Path"
                                    Command="{Binding BrowseVerifyFolderCommand}"
                                    Margin="0,2,8,2"
                                    Padding="12,4" />
                            <Button Content="&#x2714; Verify folder"
                                    AutomationProperties.Name="Verify folder"
                                    Command="{Binding VerifyCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Margin="0,2,8,2"
                                    Padding="12,4" />
                            <Button Content="&#x1F4BF; Verify disc in drive"
                                    AutomationProperties.Name="Verify disc in drive"
                                    Command="{Binding VerifyDriveCommand}"
                                    Margin="0,2,0,2"
                                    Padding="12,4" />
                        </WrapPanel>
                    </Grid>

                    <!-- Verification Summary & Repair Button -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding VerificationSummary}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <Button Grid.Column="1"
                                Content="🛠 Repair"
                                AutomationProperties.Name="Repair"
                                Command="{Binding RepairCommand}"
                                Visibility="{Binding CanRepair, Converter={StaticResource BoolToVis}}"
                                ToolTip="Repairs a copied folder using its PAR2 recovery data. Discs are read-only: copy the disc to a folder first."
                                Padding="14,4"
                                Margin="8,0,0,0" />
                    </Grid>

                    <!-- Verification Problems List -->
                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4"
                            MinHeight="60"
                            MaxHeight="140">
                        <ListBox ItemsSource="{Binding VerificationProblems}"
                                 AutomationProperties.Name="Verification Problems"
                                 FontFamily="Consolas, Courier New, monospace"
                                 FontSize="12"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 3: FOOTER - STATUS & PROGRESS                                        -->
            <!-- ========================================================================= -->
            <Border Grid.Row="3"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,16,0" />

                    <ProgressBar Grid.Column="1"
                                 AutomationProperties.Name="Archive Progress"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Height="6"
                                 VerticalAlignment="Center"
                                 Margin="0,0,16,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                    <Button Grid.Column="2"
                            Content="🛑 Cancel"
                            AutomationProperties.Name="Cancel"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            Padding="12,4" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
