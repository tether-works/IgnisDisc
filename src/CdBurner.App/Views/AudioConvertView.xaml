<UserControl x:Class="CdBurner.App.Views.AudioConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AudioConvertViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Files to convert -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox Grid.Column="0"
                         Height="110"
                         AutomationProperties.Name="Files and folders to convert"
                         ItemsSource="{Binding Inputs}"
                         SelectedItem="{Binding SelectedInput}"
                         Background="{DynamicResource ControlBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource ControlBorderBrush}"
                         Margin="0,0,12,0"
                         ToolTip="Audio files and folders to convert: WAV, FLAC, MP3, AAC, Ogg, Opus, WMA and AIFF. The originals are never changed." />
                <StackPanel Grid.Column="1" Width="150">
                    <Button Content="Add files..."
                            AutomationProperties.Name="Add files to convert"
                            Command="{Binding AddFilesCommand}"
                            Margin="0,0,0,6"
                            ToolTip="Choose audio files to convert" />
                    <Button Content="Add folder..."
                            AutomationProperties.Name="Add folder to convert"
                            Command="{Binding AddFolderCommand}"
                            Margin="0,0,0,6"
                            ToolTip="Choose a folder of audio files to convert" />
                    <Button Content="Remove selected"
                            AutomationProperties.Name="Remove selected entry"
                            Command="{Binding RemoveSelectedCommand}"
                            Margin="0,0,0,6"
                            ToolTip="Remove the highlighted entry from the list" />
                    <Button Content="Clear list"
                            AutomationProperties.Name="Clear the list"
                            Command="{Binding ClearCommand}"
                            ToolTip="Remove every entry from the list" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Output options -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="300"
                      Margin="0,0,0,12">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12">
                <StackPanel>
                    <CheckBox Content="Include subfolders"
                              AutomationProperties.Name="Include subfolders"
                              IsChecked="{Binding Recursive}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,10"
                              ToolTip="Search inside the added folders, including their subfolders." />

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Convert to:"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,12,0" />
                        <CheckBox Content="FLAC"
                                  AutomationProperties.Name="Convert to FLAC"
                                  IsChecked="{Binding ConvertToFlac}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,2,16,2"
                                  ToolTip="Lossless FLAC files" />
                        <CheckBox Content="MP3"
                                  AutomationProperties.Name="Convert to MP3"
                                  IsChecked="{Binding ConvertToMp3}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,2,16,2"
                                  ToolTip="MP3 files" />
                        <CheckBox Content="Opus"
                                  AutomationProperties.Name="Convert to Opus"
                                  IsChecked="{Binding ConvertToOpus}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,2,16,2"
                                  ToolTip="Opus files" />
                        <CheckBox Content="AAC"
                                  AutomationProperties.Name="Convert to AAC"
                                  IsChecked="{Binding ConvertToAac}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,2,0,2"
                                  ToolTip="AAC (.m4a) files" />
                    </WrapPanel>

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="MP3 quality:"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,10,0" />
                        <ComboBox Width="210"
                                  AutomationProperties.Name="MP3 quality"
                                  ItemsSource="{Binding Mp3QualityChoices}"
                                  SelectedItem="{Binding SelectedMp3Quality}"
                                  IsEnabled="{Binding Mp3Selected}"
                                  Margin="0,0,20,0"
                                  ToolTip="Constant bitrate or variable bitrate (VBR) for MP3 files. Available when MP3 is checked." />
                        <TextBlock Text="Opus/AAC bitrate (kbit/s):"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,10,0" />
                        <TextBox Width="70"
                                 AutomationProperties.Name="Opus and AAC bitrate in kilobits per second"
                                 Text="{Binding BitrateKbps, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding BitrateApplies}"
                                 Padding="8,6"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}"
                                 ToolTip="Opus 6-510, AAC 96, 128, 160 or 192. Empty uses the default for the format. Available when Opus or AAC is checked." />
                    </WrapPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Output folder:"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,10,0" />
                        <TextBox Grid.Column="1"
                                 AutomationProperties.Name="Output folder for converted files"
                                 Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}"
                                 Margin="0,0,8,0"
                                 ToolTip="Converted files are written here. Each format gets its own folder when more than one is chosen." />
                        <Button Grid.Column="2"
                                Content="Browse..."
                                AutomationProperties.Name="Browse Output Folder"
                                Command="{Binding BrowseOutputFolderCommand}"
                                ToolTip="Choose the output folder"
                                VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="File names:"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,10,0" />
                        <TextBox Grid.Column="1"
                                 AutomationProperties.Name="File names template"
                                 Text="{Binding NamingTemplate, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}"
                                 ToolTip="Optional. Tokens read from each file's tags: {albumartist} {artist} {album} {year} {track} {title} {disc} {format}. Empty keeps each file's folder structure." />
                    </Grid>
                    <TextBlock Text="Empty: keep the folder structure of the added folders"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,2,0,0" />
                    <TextBlock Text="{Binding NamingProblem}"
                               AutomationProperties.Name="File names problem"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource CapacityOverburnBrush}"
                               Margin="0,2,0,8" />

                    <CheckBox Content="Replace existing files"
                              AutomationProperties.Name="Replace existing files"
                              IsChecked="{Binding Overwrite}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              ToolTip="Overwrite files that already exist in the output folder. Off: those files are skipped." />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Report -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox Text="{Binding Report, Mode=OneWay}"
                         AutomationProperties.Name="Conversion report"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         FontSize="12"
                         Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderThickness="0"
                         Padding="4" />
            </ScrollViewer>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ProgressBar Height="6"
                                 AutomationProperties.Name="Conversion progress"
                                 IsIndeterminate="True"
                                 Margin="0,6,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancel"
                            AutomationProperties.Name="Cancel conversion"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            ToolTip="Stop converting. Files finished before the cancel are kept."
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            Padding="18,10"
                            FontSize="14"
                            Margin="0,0,8,0" />
                    <Button Content="Convert"
                            AutomationProperties.Name="Convert files"
                            Command="{Binding ConvertCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTip="Convert the listed files with ffmpeg (the optional ffmpeg download). The originals are not changed."
                            Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                            Padding="24,10"
                            FontSize="14"
                            FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
