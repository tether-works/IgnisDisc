<UserControl x:Class="CdBurner.App.Views.DvdVideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:controls="clr-namespace:CdBurner.App.Controls"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DvdVideoViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             AllowDrop="True"
             Drop="OnFileDrop"
             PreviewDragOver="OnPreviewDragOver">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToBrushConverter x:Key="BoolToBrush" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <!-- ========================================================================= -->
        <!-- MODE: DVD-Video or Blu-ray Video (BDMV / AVCHD)                           -->
        <!-- ========================================================================= -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="16,16,16,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Disc format:"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,8,0" />
                    <ComboBox Width="220"
                              AutomationProperties.Name="Authoring mode"
                              ItemsSource="{Binding AuthoringModes}"
                              SelectedItem="{Binding SelectedAuthoringMode}"
                              ToolTip="DVD-Video makes a DVD with menus. Blu-ray Video makes a BDMV disc image from the same movie list." />
                </StackPanel>

                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding IsBluRayMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding BdmvSourceSummary}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add Movie(s)..."
                                AutomationProperties.Name="Add movies to the Blu-ray Video"
                                Command="{Binding AddMovieFilesCommand}"
                                Margin="0,2,8,2" />
                        <Button Content="Add Subtitle File (.srt)..."
                                AutomationProperties.Name="Add a subtitle file to the Blu-ray Video"
                                Command="{Binding AddBdmvSubtitleCommand}"
                                ToolTip="Each .srt file becomes one picture-based (PGS) subtitle track."
                                Margin="0,2,8,2" />
                        <Button Content="Clear Movies"
                                AutomationProperties.Name="Clear the movie list"
                                Command="{Binding ClearSourceCommand}"
                                Margin="0,2,0,2" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding BdmvSubtitleFiles}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Content="Remove"
                                            AutomationProperties.Name="Remove this subtitle file"
                                            Command="{Binding DataContext.RemoveBdmvSubtitleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                            <TextBlock Text="Disc type:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" />
                            <ComboBox Width="250"
                                      AutomationProperties.Name="Blu-ray disc type"
                                      ItemsSource="{Binding AvailableBdmvTargets}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      SelectedValue="{Binding BdmvTarget}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                            <TextBlock Text="Picture:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" />
                            <ComboBox Width="130"
                                      AutomationProperties.Name="Blu-ray picture format"
                                      ItemsSource="{Binding AvailableBdmvVideoFormats}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      SelectedValue="{Binding BdmvVideoFormat}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                            <TextBlock Text="Audio:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" />
                            <ComboBox Width="170"
                                      AutomationProperties.Name="Blu-ray audio encoding"
                                      ItemsSource="{Binding AvailableBdmvAudioCodecs}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      SelectedValue="{Binding BdmvAudioCodec}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                            <TextBlock Text="Video kbit/s:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" />
                            <TextBox Width="70"
                                     AutomationProperties.Name="Blu-ray video bitrate in kilobits per second"
                                     Text="{Binding BdmvVideoBitrateKbps, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                            <TextBlock Text="Volume label:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" />
                            <TextBox Width="160"
                                     AutomationProperties.Name="Blu-ray volume label"
                                     Text="{Binding VolumeLabel, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox Content="Make subtitles from speech"
                                  AutomationProperties.Name="Make Blu-ray subtitles from speech"
                                  IsChecked="{Binding GenerateSubtitles}"
                                  ToolTip="Uses the optional speech-recognition download; the text is machine-generated and can contain mistakes."
                                  VerticalAlignment="Center"
                                  Margin="0,2,14,2" />
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Build Blu-ray Video Image..."
                                AutomationProperties.Name="Build Blu-ray Video image"
                                Command="{Binding BuildBdmvImageCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTip="Encodes the movies with FFmpeg, writes the BDMV files and packs them on a UDF 2.50 image. Nothing is burned."
                                Margin="0,2,10,2" />
                        <Button Content="Cancel"
                                AutomationProperties.Name="Cancel the Blu-ray Video build"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                Margin="0,2,10,2" />
                    </WrapPanel>
                    <ProgressBar Height="8"
                                 AutomationProperties.Name="Blu-ray Video build progress"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding BurnProgress}"
                                 Margin="0,6,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="Checked against the Blu-ray file-format rules only. Not yet played on a Blu-ray player, so player compatibility is not claimed."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16" Visibility="{Binding IsDvdMode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <!-- Row 0: Top VIDEO_TS / Source Media Selection Card -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Validation Summary & Dual-Layer Card -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Physical Extent & 32KB ECC Alignment Table -->
                <RowDefinition Height="*" MinHeight="150" />
                <!-- Row 3: Bottom Action & Status Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: SOURCE SELECTION, AUTHORING OPTIONS & VALIDATION TRIGGER           -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Source Path Row -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Source Movie(s) / Folder:"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,10,0" />
                    <TextBox Grid.Column="1"
                             AutomationProperties.Name="Source Movie(s) / Folder"
                             Text="{Binding VideoTsFolderPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             Padding="8,6"
                             Background="{DynamicResource ControlBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource ControlBorderBrush}" />
                </Grid>

                <!-- Source Action Buttons: wrap cleanly at narrow widths -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="&#x1F3AC; Add Movie(s)..."
                            AutomationProperties.Name="Add Movie(s)"
                            Command="{Binding AddMovieFilesCommand}"
                            VerticalAlignment="Center"
                            Margin="0,2,8,2" />
                    <Button Content="&#x1F4C2; Browse Folder..."
                            AutomationProperties.Name="Browse Folder"
                            Command="{Binding SelectVideoTsFolderCommand}"
                            VerticalAlignment="Center"
                            Margin="0,2,8,2" />
                    <Button Content="&#x1F50D; Validate &amp; Plan Layout"
                            AutomationProperties.Name="Validate &amp; Plan Layout"
                            Command="{Binding ValidateAndPlanLayoutCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center"
                            Margin="0,2,8,2" />
                    <Button Content="&#x1F4C4; New DVD"
                            AutomationProperties.Name="New DVD"
                            Command="{Binding NewDvdCommand}"
                            ToolTip="Start a different DVD: clears the movies, subtitle choices, disc name and menu title. Standard, aspect and other settings stay."
                            VerticalAlignment="Center"
                            Margin="0,2,0,2" />
                </WrapPanel>

                <!-- Options Sub-row -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <WrapPanel Orientation="Horizontal"
                               VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                            <TextBlock Text="Volume Label:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0" />
                            <TextBox Width="130"
                                     AutomationProperties.Name="Volume Label"
                                     Text="{Binding VolumeLabel, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="32"
                                     Padding="6,4"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                            <TextBlock Text="Menu Title:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0" />
                            <TextBox Width="160"
                                     AutomationProperties.Name="Menu Title"
                                     Text="{Binding MenuTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                            <TextBlock Text="Standard:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0" />
                            <ComboBox Width="80"
                                      AutomationProperties.Name="Standard"
                                      ItemsSource="{Binding AvailableStandards}"
                                      SelectedItem="{Binding SelectedStandard}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                            <TextBlock Text="Aspect:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0" />
                            <ComboBox Width="160"
                                      AutomationProperties.Name="Aspect Ratio"
                                      ItemsSource="{Binding AvailableAspectRatios}"
                                      SelectedItem="{Binding SelectedAspectRatio}" />
                        </StackPanel>

                        <CheckBox Content="Create title menu"
                                  AutomationProperties.Name="Create title menu"
                                  IsChecked="{Binding AutoCreatePlayMenu}"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,2,14,2" />

                        <CheckBox Content="Generate subtitles"
                                  AutomationProperties.Name="Generate subtitles"
                                  IsChecked="{Binding GenerateSubtitles}"
                                  ToolTip="Makes subtitles by speech recognition for movies with no .srt file next to them. Machine-generated: names and quiet speech are sometimes misheard. Fast on a graphics card (NVIDIA, AMD or Intel), slower on integrated graphics, slowest on the processor."
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,2,6,2" />
                        <TextBox Width="44"
                                 AutomationProperties.Name="Subtitle language"
                                 Text="{Binding SubtitleLanguage, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding GenerateSubtitles}"
                                 ToolTip="Spoken language: a two-letter code such as en, de, fr, or auto"
                                 VerticalAlignment="Center"
                                 Margin="0,2,8,2" />
                        <Button Content="&#x2B07; Install subtitle tool (1-Click)"
                                AutomationProperties.Name="Install subtitle tool (1-Click)"
                                Command="{Binding InstallSubtitleToolCommand}"
                                Visibility="{Binding IsSubtitleToolOfferVisible, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding SubtitleToolOfferText}"
                                Padding="10,3"
                                FontSize="11.5"
                                VerticalAlignment="Center"
                                Margin="0,2,14,2" />

                        <Separator Style="{x:Null}" Width="1" Height="18" Background="{DynamicResource CardBorderBrush}" Margin="4,2,14,2" VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                            <TextBlock Text="Target Media:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="{Binding MediaRequirementText}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding FfmpegStatusText}"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,8,2" />
                        <Button Content="&#x2B07; Install FFmpeg (1-Click)"
                                AutomationProperties.Name="Install FFmpeg (1-Click)"
                                Command="{Binding InstallFfmpegCommand}"
                                Visibility="{Binding IsFfmpegMissing, Converter={StaticResource BoolToVis}}"
                                ToolTip="Downloads the official full Windows build of FFmpeg into %LOCALAPPDATA%\Programs\ffmpeg for automatic video transcoding"
                                Padding="10,3"
                                FontSize="11.5"
                                Margin="0,2,0,2"
                                VerticalAlignment="Center" />
                    </WrapPanel>

                    <WrapPanel Orientation="Horizontal"
                               Margin="0,8,0,0"
                               VerticalAlignment="Center"
                               IsEnabled="{Binding AreAuthoringOptionsEnabled}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                            <TextBlock Text="Menu autoplay:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,6,0" />
                            <ComboBox Width="110"
                                      AutomationProperties.Name="Menu autoplay"
                                      ItemsSource="{Binding MenuAutoPlayChoices}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      SelectedValue="{Binding MenuAutoPlaySeconds}"
                                      IsEnabled="{Binding AutoCreatePlayMenu}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                            <TextBlock Text="After a film:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,6,0" />
                            <ComboBox Width="130"
                                      AutomationProperties.Name="Action after each film"
                                      ItemsSource="{Binding AvailableAfterTitleActions}"
                                      SelectedItem="{Binding AfterTitleAction}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                            <TextBlock Text="Chapters:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,6,0" />
                            <ComboBox Width="115"
                                      AutomationProperties.Name="Chapter interval"
                                      ItemsSource="{Binding ChapterIntervalChoices}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      SelectedValue="{Binding ChapterIntervalMinutes}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                            <TextBlock Text="Video quality:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,6,0" />
                            <ComboBox Width="160"
                                      AutomationProperties.Name="Video quality"
                                      ItemsSource="{Binding AvailableQualityPresets}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedQualityPreset}" />
                        </StackPanel>

                        <CheckBox Content="Show subtitles by default"
                                  AutomationProperties.Name="Show subtitles by default"
                                  IsChecked="{Binding SubtitlesOnByDefault}"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,2,14,2" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                            <TextBlock Text="Subtitle size:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,6,0" />
                            <ComboBox Width="95"
                                      AutomationProperties.Name="Subtitle text size"
                                      ItemsSource="{Binding AvailableSubtitleSizes}"
                                      SelectedItem="{Binding SubtitleSize}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

                <!-- Subtitles per movie: which .srt was found or chosen, with Choose / No subtitles -->
                <StackPanel Grid.Row="3"
                            Margin="0,10,0,0"
                            Visibility="{Binding HasSubtitleRows, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Subtitles:"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding SubtitleRows}" AutomationProperties.Name="Subtitles per movie">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MaxWidth="240" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding MovieName}"
                                                   ToolTip="{Binding MoviePath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding MenuTitleName, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Menu title name"
                                                 ToolTip="Title shown on the DVD title menu"
                                                 MaxLength="80"
                                                 Padding="6,3"
                                                 Background="{DynamicResource ControlBackgroundBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource ControlBorderBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StatusText}"
                                                   ToolTip="{Binding SubtitlePath}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <Button Grid.Column="3"
                                                Content="Choose .srt..."
                                                AutomationProperties.Name="Choose subtitle file"
                                                Command="{Binding DataContext.ChooseSubtitleFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,3"
                                                FontSize="11.5"
                                                Margin="0,0,6,0" />
                                        <Button Grid.Column="4"
                                                Content="No subtitles"
                                                AutomationProperties.Name="Use no subtitle file"
                                                ToolTip="Leave this movie's subtitle file off the disc (with Generate subtitles on, they are made by speech recognition instead)"
                                                Command="{Binding DataContext.ClearSubtitleFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasSubtitleFile, Converter={StaticResource BoolToVis}}"
                                                Padding="10,3"
                                                FontSize="11.5" />
                                    </Grid>
                                    <WrapPanel Orientation="Horizontal" Margin="14,3,0,0">
                                        <TextBlock Text="Audio tracks (max 8):"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Button Content="+ Audio Track..."
                                                AutomationProperties.Name="Add audio track"
                                                Command="{Binding DataContext.AddAudioTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanAddAudioTrack}"
                                                Padding="8,2"
                                                FontSize="11"
                                                Margin="0,0,12,0" />
                                        <TextBlock Text="Subtitle tracks (max 8):"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Button Content="+ Subtitle Track..."
                                                AutomationProperties.Name="Add subtitle track"
                                                Command="{Binding DataContext.AddSubtitleTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanAddSubtitleTrack}"
                                                Padding="8,2"
                                                FontSize="11" />
                                    </WrapPanel>
                                    <ItemsControl ItemsSource="{Binding AudioTracks}"
                                                  Visibility="{Binding HasAudioTracks, Converter={StaticResource BoolToVis}}"
                                                  Margin="22,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <WrapPanel Orientation="Horizontal" Margin="0,1">
                                                    <TextBlock Text="{Binding StreamIdLabel}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding SourceName}" ToolTip="{Binding SourcePath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBox Width="44" Text="{Binding Language, UpdateSourceTrigger=LostFocus}" ToolTip="ISO 639-2 language code (e.g. eng, spa, fra)" FontSize="11" Padding="4,1" Margin="0,0,6,0" />
                                                    <ComboBox Width="56" ItemsSource="{Binding AvailableChannels}" SelectedItem="{Binding Channels}" ToolTip="Channel count (2 = stereo, 6 = 5.1)" FontSize="11" Margin="0,0,6,0" />
                                                    <ComboBox Width="140" ItemsSource="{Binding AvailableContentKinds}" SelectedItem="{Binding ContentKind}" ToolTip="Audio stream role" FontSize="11" Margin="0,0,6,0" />
                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.RemoveAudioTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="6,1"
                                                            FontSize="10.5" />
                                                </WrapPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding SubtitleTracks}"
                                                  Visibility="{Binding HasSubtitleTracks, Converter={StaticResource BoolToVis}}"
                                                  Margin="22,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <WrapPanel Orientation="Horizontal" Margin="0,1">
                                                    <TextBlock Text="{Binding StreamIdLabel}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding SourceName}" ToolTip="{Binding SourcePath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBox Width="44" Text="{Binding Language, UpdateSourceTrigger=LostFocus}" ToolTip="ISO 639-2 language code (e.g. eng, spa, fra)" FontSize="11" Padding="4,1" Margin="0,0,6,0" />
                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.RemoveSubtitleTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="6,1"
                                                            FontSize="10.5" />
                                                </WrapPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- How the movies fit on a DVD once converted: full quality, compressed to fit, dual-layer, or too long -->
                <Grid Grid.Row="4"
                      Margin="0,10,0,0"
                      Visibility="{Binding HasFitSummary, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Fits on disc:"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Top"
                               Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding FitSummaryText}"
                                   AutomationProperties.AutomationId="FitSummary"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding FitStatus, Converter={StaticResource CapacityStatusToBrushConverter}}" />
                        <!-- Offered when a 4.7 GB DVD has to compress and a dual-layer DVD would keep it clearly sharper -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,6,0,0"
                                    Visibility="{Binding HasLayerChoice, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Disc:"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <RadioButton GroupName="DvdLayerChoice"
                                         Content="{Binding SingleLayerChoiceText}"
                                         AutomationProperties.Name="Use a 4.7 GB DVD"
                                         IsChecked="{Binding UseSingleLayerDisc}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,18,0" />
                            <RadioButton GroupName="DvdLayerChoice"
                                         Content="{Binding DualLayerChoiceText}"
                                         AutomationProperties.Name="Use a dual-layer DVD"
                                         IsChecked="{Binding UseDualLayerDisc}"
                                         VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Menu Personalization & Live Still-Menu Preview -->
                <Border Grid.Row="5"
                        Margin="0,12,0,0"
                        Padding="12"
                        Background="{DynamicResource SurfaceBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding AutoCreatePlayMenu, Converter={StaticResource BoolToVis}}"
                        IsEnabled="{Binding AreAuthoringOptionsEnabled}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Styling, Chapter Submenus, Background Image & Menu Audio Controls -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Menu Styling &amp; Chapter Submenus"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,8" />

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Include chapter submenus"
                                          AutomationProperties.Name="Include chapter submenus"
                                          IsChecked="{Binding GenerateChapterMenus}"
                                          ToolTip="Generates paginated per-title chapter selection submenus with a Back to Main Menu button"
                                          VerticalAlignment="Center"
                                          Margin="0,2,16,4" />

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,4">
                                    <TextBlock Text="Font:"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,6,0" />
                                    <ComboBox Width="120"
                                              AutomationProperties.Name="Menu font preset"
                                              ItemsSource="{Binding AvailableMenuFontPresets}"
                                              SelectedItem="{Binding SelectedMenuFontPreset}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,4">
                                    <TextBlock Text="Highlight:"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,6,0" />
                                    <ComboBox Width="110"
                                              AutomationProperties.Name="Menu highlight color preset"
                                              ItemsSource="{Binding AvailableMenuHighlightPresets}"
                                              SelectedItem="{Binding SelectedMenuHighlightPreset}" />
                                </StackPanel>
                            </WrapPanel>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                                <TextBlock Text="Background:"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,6,0" />
                                <Button Content="Background Image..."
                                        AutomationProperties.Name="Choose menu background image"
                                        Command="{Binding BrowseMenuBackgroundCommand}"
                                        Padding="10,3"
                                        FontSize="11.5"
                                        Margin="0,2,6,2" />
                                <Button Content="Clear"
                                        AutomationProperties.Name="Clear menu background image"
                                        Command="{Binding ClearMenuBackgroundCommand}"
                                        Visibility="{Binding HasMenuBackgroundImage, Converter={StaticResource BoolToVis}}"
                                        Padding="8,3"
                                        FontSize="11.5"
                                        Margin="0,2,10,2" />
                                <TextBlock Text="{Binding MenuBackgroundStatusText}"
                                           ToolTip="{Binding MenuBackgroundImagePath}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11.5"
                                           Margin="0,2,16,2" />

                                <TextBlock Text="Menu Audio:"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,6,0" />
                                <Button Content="Menu Audio..."
                                        AutomationProperties.Name="Choose menu background audio"
                                        Command="{Binding BrowseMenuAudioCommand}"
                                        Padding="10,3"
                                        FontSize="11.5"
                                        Margin="0,2,6,2" />
                                <Button Content="Clear"
                                        AutomationProperties.Name="Clear menu background audio"
                                        Command="{Binding ClearMenuAudioCommand}"
                                        Visibility="{Binding HasMenuAudio, Converter={StaticResource BoolToVis}}"
                                        Padding="8,3"
                                        FontSize="11.5"
                                        Margin="0,2,10,2" />
                                <TextBlock Text="{Binding MenuAudioStatusText}"
                                           ToolTip="{Binding MenuAudioPath}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11.5"
                                           Margin="0,2,0,2" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- Right: Live Still-Menu Preview -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Background="#0E0E10"
                                    Width="284"
                                    Height="160">
                                <Image Source="{Binding MenuPreviewImage}"
                                       AutomationProperties.Name="Live DVD menu preview"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Button Content="&lt; Prev"
                                        AutomationProperties.Name="Previous menu preview page"
                                        Command="{Binding PreviousMenuPreviewPageCommand}"
                                        Padding="8,2"
                                        FontSize="11"
                                        Margin="0,0,6,0" />
                                <TextBlock Text="{Binding MenuPreviewPageText}"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,6,0" />
                                <Button Content="Next &gt;"
                                        AutomationProperties.Name="Next menu preview page"
                                        Command="{Binding NextMenuPreviewPageCommand}"
                                        Padding="8,2"
                                        FontSize="11"
                                        Margin="0,0,8,0" />
                                <CheckBox Content="Chapters view"
                                          AutomationProperties.Name="Preview chapter submenu"
                                          IsChecked="{Binding PreviewChapterSubmenu}"
                                          Visibility="{Binding GenerateChapterMenus, Converter={StaticResource BoolToVis}}"
                                          VerticalAlignment="Center"
                                          FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: VALIDATION STATUS & DUAL-LAYER PANEL                               -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <!-- Left: Compliance Status Badge -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="DVD-Video Compliance:"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,4" />
                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{Binding IsStructureValid, Converter={StaticResource BoolToBrush}}"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Padding="12,6"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding IsStructureValid, Converter={StaticResource BoolToBrush}}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ValidationStatusText}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: Validation Messages List -->
                <ScrollViewer Grid.Column="1" MaxHeight="72" VerticalScrollBarVisibility="Auto" Margin="12,0">
                    <ItemsControl ItemsSource="{Binding ValidationMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Right: DVD-9 Dual-Layer Break Picker -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="DVD-9 Layer Break (OTP):"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding CandidateLayerBreakLbas}"
                                  AutomationProperties.Name="DVD-9 Layer Break (OTP)"
                                  SelectedItem="{Binding SelectedLayerBreakLba}"
                                  IsEnabled="{Binding IsDualLayerRequired}"
                                  ToolTip="Cell boundaries where the layer change can go (players expect it at the start of a cell). The address shown is on the planned layout; the burn finds the same cell in the built disc image and uses the nearest one on a 16-sector block. Applied only with Direct drive commands.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='LBA {0:N0}'}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Cell boundary; used with Direct drive commands"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 2: PHYSICAL EXTENT & 32 KB ECC GAP ALIGNMENT TABLE                     -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="6,6,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Table Header Ribbon -->
                <Border Grid.Row="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Grid>
                        <TextBlock Text="Physical Extent Map &amp; 32 KB (16-sector) ECC Alignment Gaps"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center">
                            <Run Text="Total Sectors: " />
                            <Run Text="{Binding TotalSectors, Mode=OneWay, StringFormat='{}{0:N0}'}" FontWeight="Bold" />
                            <Run Text=" | Size: " />
                            <Run Text="{Binding FormattedTotalSize, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          AutomationProperties.Name="Physical Extent Map"
                          ItemsSource="{Binding ExtentLayoutRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <!-- File Name + Icon -->
                        <DataGridTemplateColumn Header="File / Extent" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,2">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FileName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Start LBA -->
                        <DataGridTextColumn Header="Start LBA"
                                            Binding="{Binding StartLba, StringFormat='{}{0:N0}'}"
                                            Width="120" />

                        <!-- End LBA -->
                        <DataGridTextColumn Header="End LBA"
                                            Binding="{Binding EndLba, StringFormat='{}{0:N0}'}"
                                            Width="120" />

                        <!-- Sector Count -->
                        <DataGridTextColumn Header="Sectors"
                                            Binding="{Binding SectorCount, StringFormat='{}{0:N0}'}"
                                            Width="100" />

                        <!-- Size -->
                        <DataGridTextColumn Header="Size"
                                            Binding="{Binding DisplaySize}"
                                            Width="140" />

                        <!-- Status / ECC Gap -->
                        <DataGridTextColumn Header="ECC Alignment / Status"
                                            Binding="{Binding Status}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 3: BOTTOM ACTIONS & PROGRESS BAR                                      -->
        <!-- ========================================================================= -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,6,6"
                Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status line and progress bar: their own full-width row, so the buttons above can never squeeze them to nothing -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding StatusMessage}"
                                   FontStyle="Italic"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StatusMessage}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding BurnProgress, StringFormat='{}{0:F1}%'}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <ProgressBar Height="8"
                                 AutomationProperties.Name="Burn Progress"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding BurnProgress}"
                                 Margin="0,6,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Action buttons: wrap onto a second line on a narrow window instead of running off the edge -->
                <WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Burn To:"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,8,0" />
                    <ComboBox Width="250"
                              AutomationProperties.Name="Burn To Optical Drive"
                              ItemsSource="{Binding AvailableRecorders}"
                              SelectedItem="{Binding SelectedRecorder}"
                              ToolTip="Select the optical drive to burn this DVD-Video disc to"
                              Margin="0,0,12,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding VendorId}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Content="🛑 Cancel"
                            AutomationProperties.Name="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            ToolTip="Cancel ongoing DVD authoring or burn"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,10,0" />
                    <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Fill empty space with a picture"
                                      AutomationProperties.Name="Fill empty space with a picture"
                                      IsChecked="{Binding FillWithPicture}"
                                      ToolTip="{Binding FillPictureNote}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            <CheckBox Content="Frame of the movie"
                                      AutomationProperties.Name="Use a frame of the movie as the fill picture"
                                      IsChecked="{Binding FillPictureFromMovie}"
                                      Visibility="{Binding FillWithPicture, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Takes one frame of the main movie with FFmpeg. Without FFmpeg the disc is burned without the picture, and the status line says so."
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            <Button Content="Picture..."
                                    AutomationProperties.Name="Choose the fill picture"
                                    Command="{Binding BrowseFillPictureCommand}"
                                    Visibility="{Binding FillWithPicture, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding FillPicturePath}" />
                        </StackPanel>
                        <TextBlock Text="{Binding FillPictureNote}"
                                   Visibility="{Binding FillWithPicture, Converter={StaticResource BoolToVis}}"
                                   TextWrapping="Wrap"
                                   MaxWidth="520"
                                   HorizontalAlignment="Left"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <CheckBox Content="Direct drive commands (experimental)"
                              AutomationProperties.Name="Direct drive commands (experimental)"
                              IsChecked="{Binding UseDirectDriveCommands}"
                              ToolTip="Burn with IgnisDisc's own drive commands instead of the Windows writer, then read the disc back to check it. On a dual-layer DVD+R the layer break goes on the chosen cell boundary, which the Windows writer cannot do. Covers the same discs as on the Data Disc screen."
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
                    <CheckBox Content="Set DVD+R/+R DL Book Type to DVD-ROM when supported"
                              AutomationProperties.Name="Set DVD+R/+R DL Book Type to DVD-ROM when supported"
                              IsChecked="{Binding SetDvdRomBookTypeWhenSupported}"
                              ToolTip="Before burning DVD+R or DVD+R DL media, attempt to set its Book Type to DVD-ROM for better compatibility with legacy DVD players. Unsupported drives report cleanly without failing the burn."
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
                    <Button Content="💾 Build DVD ISO..."
                            AutomationProperties.Name="Build DVD ISO"
                            Command="{Binding BuildDvdIsoCommand}"
                            ToolTip="Build compliant DVD-Video ISO image with 32 KB ECC gap alignment"
                            Margin="0,0,10,0" />
                    <Button Content="🎬 Burn DVD-Video"
                            AutomationProperties.Name="Burn DVD-Video"
                            Command="{Binding StartDvdBurnCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTip="Burn DVD-Video structure directly to selected optical recorder"
                            MinWidth="130" />
                </WrapPanel>

                <controls:BurnTelemetryChartControl Grid.Row="2"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    DataContext="{Binding Telemetry}"
                                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,10,0,0" />
            </Grid>
        </Border>
        </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
