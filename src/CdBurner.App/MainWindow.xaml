<Window x:Class="CdBurner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CdBurner.App.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
        xmlns:converters="clr-namespace:CdBurner.App.Converters"
        mc:Ignorable="d"
        Title="IgnisDisc Optical Studio v1.18"
        Icon="Assets/IgnisDisc.png"
        Height="760"
        Width="1280"
        MinHeight="620"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- DataTemplate for Workspace Modules -->
        <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="12"
                    Padding="20,14,20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Workspace Header: title and description on one line, so the workspace below keeps its height -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Title}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Description}"
                                   ToolTip="{Binding Description}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="14,2,0,0" />
                    </Grid>

                    <!-- Workspace Separator -->
                    <Separator Grid.Row="1"
                               Background="{DynamicResource CardBorderBrush}"
                               Margin="0,0,0,12" />

                    <!-- Workspace Content or Placeholder Surface -->
                    <Grid Grid.Row="2">
                        <!-- Custom module content (e.g. DataBurnView, DvdVideoView) -->
                        <ContentControl Content="{Binding Content}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Visibility="{Binding Content, Converter={StaticResource NullToVisibilityConverter}}" />

                        <!-- Placeholder surface when no active view model is attached -->
                        <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="24"
                                Visibility="{Binding Content, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{loc:Loc UiShellOpticalMasteringWorkspace}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Description}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Zone 1: Top Drive / Media Ribbon -->
            <RowDefinition Height="Auto" />
            <!-- Zone 2: Navigation Rail & Main ContentHost -->
            <RowDefinition Height="*" />
            <!-- Zone 3: Bottom Capacity & Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ZONE 1: TOP RECORDER & MEDIA RIBBON                                      -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource RibbonBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <!-- WrapPanel: groups flow onto a second row instead of being clipped on narrow windows / high DPI -->
            <WrapPanel Orientation="Horizontal">

                <!-- Left: Drive Selector & Refresh -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,24,2">
                    <TextBlock Text="{loc:Loc UiShellBurnToDrive}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,8,0" />

                    <!-- Drive DropDown -->
                    <ComboBox Width="280"
                              AutomationProperties.Name="{loc:Loc UiShellBurnToOpticalDrive}"
                              ItemsSource="{Binding AvailableRecorders}"
                              SelectedItem="{Binding SelectedRecorder}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding VolumePath}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding VendorId}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding ProductId}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text=" (Virtual)"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Visibility="{Binding IsVirtual, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Refresh Button -->
                    <Button Content="{loc:Loc UiShellRefresh}"
                            AutomationProperties.Name="{loc:Loc UiShellScanAndReEnumerateOpticalRecorders}"
                            Command="{Binding RefreshDrivesCommand}"
                            ToolTip="{loc:Loc UiShellScanAndReEnumerateOpticalRecorders}"
                            Margin="8,0,0,0" />

                    <Separator Style="{x:Null}" Width="1" Height="24" Background="{DynamicResource CardBorderBrush}" Margin="12,0" />

                    <!-- Media Badge -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding CurrentMediaStatus.MediaPresent, Converter={StaticResource MediaPresenceToBrushConverter}}"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MediaBadgeText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Tray Buttons -->
                    <Button Content="{loc:Loc UiShellEject}"
                            AutomationProperties.Name="{loc:Loc UiShellEjectDriveTrayOrUnmountMedia}"
                            Command="{Binding EjectTrayCommand}"
                            ToolTip="{loc:Loc UiShellOpenDriveTrayOrUnmountMedia}"
                            Margin="8,0,0,0" />
                    <Button Content="{loc:Loc UiShellClose}"
                            AutomationProperties.Name="{loc:Loc UiShellCloseDriveTrayAndLoadMedia}"
                            Command="{Binding CloseTrayCommand}"
                            ToolTip="{loc:Loc UiShellCloseDriveTrayAndLoadMedia}"
                            Margin="4,0,0,0" />
                </StackPanel>

                <!-- Right: Write Speed & Virtual Media Quick-Mount -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                    <TextBlock Text="{loc:Loc UiShellSpeed}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,8,0" />

                    <ComboBox Width="130"
                              AutomationProperties.Name="{loc:Loc UiShellOpticalWriteSpeed}"
                              ItemsSource="{Binding AvailableWriteSpeeds}"
                              SelectedItem="{Binding SelectedWriteSpeed}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="{Binding SpeedCapReason}"
                               Visibility="{Binding HasSpeedCapReason, Converter={StaticResource BooleanToVisibilityConverter}}"
                               ToolTip="{Binding SpeedCapReason}"
                               AutomationProperties.Name="{loc:Loc UiShellWhyTheDefaultWriteSpeedIs}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               MaxWidth="260"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="8,0,0,0" />

                    <!-- Virtual Media Quick-Mount (only when the virtual drive is enabled in Settings) -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding Settings.EnableVirtualDrive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Separator Style="{x:Null}" Width="1" Height="24" Background="{DynamicResource CardBorderBrush}" Margin="12,0" />

                    <TextBlock Text="{loc:Loc UiShellMountVirtual}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,6,0" />
                    <Button Content="CD-R"
                            AutomationProperties.Name="{loc:Loc UiShellMountBlank700MBCDR}"
                            Command="{Binding MountVirtualBlankCdRCommand}"
                            ToolTip="{loc:Loc UiShellMountBlank700MBCDR}"
                            Padding="8,4"
                            Margin="2,0" />
                    <Button Content="CD-RW"
                            AutomationProperties.Name="{loc:Loc UiShellMountBlank700MBCDRW}"
                            Command="{Binding MountVirtualBlankCdRwCommand}"
                            ToolTip="{loc:Loc UiShellMountBlank700MBCDRW}"
                            Padding="8,4"
                            Margin="2,0" />
                    <Button Content="DVD-R"
                            AutomationProperties.Name="{loc:Loc UiShellMountBlank47GBDVD}"
                            Command="{Binding MountVirtualBlankDvdRCommand}"
                            ToolTip="{loc:Loc UiShellMountBlank47GBDVD}"
                            Padding="8,4"
                            Margin="2,0" />
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- ZONE 2: LEFT NAVIGATION RAIL + MAIN CONTENTHOST                          -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Navigation Rail (8 module tabs) -->
                <ColumnDefinition Width="220" />
                <!-- Content Host Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Rail -->
            <Border Grid.Column="0"
                    Background="{DynamicResource RailBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="{loc:Loc UiShellNavigationRail}">
                    <StackPanel KeyboardNavigation.TabNavigation="Local" Margin="4,12">
                    <TextBlock Text="{loc:Loc UiShellOPTICALMASTERING}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="16,4,0,10" />

                    <!-- Tab 1: Data Disc -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 AutomationProperties.Name="{loc:Loc UiShellDataDiscWorkspace}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=DataDisc}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.DataDisc}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="{loc:Loc UiShellDataDisc}" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 2: Audio CD -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 AutomationProperties.Name="{loc:Loc UiShellAudioCDWorkspace}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=AudioCd}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.AudioCd}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎵" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="{loc:Loc UiShellAudioCD}" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 3: DVD-Video -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 AutomationProperties.Name="{loc:Loc UiShellDVDVideoWorkspace}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=DvdVideo}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.DvdVideo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎬" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="{loc:Loc UiShellDVDVideo}" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 4: Disc Image Studio -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 AutomationProperties.Name="{loc:Loc UiShellDiscImageStudioWorkspace}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=ImageStudio}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.ImageStudio}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💿" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="{loc:Loc UiShellDiscImageStudio}" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab: Archive Studio -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 AutomationProperties.Name="{loc:Loc UiShellArchiveStudioWorkspace}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=Archive}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.Archive}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗄️" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="{loc:Loc UiShellArchive}" />
                        </StackPanel>
                    </RadioButton>

                    <Separator Style="{x:Null}" Height="1" Background="{DynamicResource CardBorderBrush}" Margin="12,12" />

                    <TextBlock Text="{loc:Loc UiShellTOOLSSETTINGS}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="16,4,0,10" />

                    <!-- Tab 5: Drive Utilities -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 AutomationProperties.Name="{loc:Loc UiShellDriveUtilitiesWorkspace}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=DriveUtilities}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.DriveUtilities}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔧" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="{loc:Loc UiShellDriveUtilities}" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 6: Virtual Drive -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 AutomationProperties.Name="{loc:Loc UiShellVirtualDriveWorkspace}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=VirtualDrive}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.VirtualDrive}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="{loc:Loc UiShellVirtualDrive}" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Disc picture calibration -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 AutomationProperties.Name="{loc:Loc UiShellCalibrationWorkspace}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=DiscCalibration}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.DiscCalibration}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="{loc:Loc UiShellCalibration}" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Disc art (picture discs) -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 AutomationProperties.Name="{loc:Loc UiShellDiscArtWorkspace}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=DiscArt}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.DiscArt}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖼️" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="{loc:Loc UiShellDiscArt}" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 7: Settings -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 AutomationProperties.Name="{loc:Loc UiShellSettingsWorkspace}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=Settings}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.Settings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="{loc:Loc UiShellSettings}" />
                        </StackPanel>
                    </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Main ContentHost -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentWorkspaceViewModel}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>

        <!-- ========================================================================= -->
        <!-- ZONE 3: BOTTOM CAPACITY METER & STATUS BAR                               -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="1.3*" MinWidth="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="180" />
                </Grid.ColumnDefinitions>

                <!-- Left: Drive Summary -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MaxWidth="200" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding DriveStatusSummary}"
                               ToolTip="{Binding DriveStatusSummary}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="|"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="8,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding MediaDetailsText}"
                               ToolTip="{Binding MediaDetailsText}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Center: Segmented Capacity Progress Bar -->
                <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Two columns, so on a narrow window the sector count trims instead of overlapping "Used". -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock HorizontalAlignment="Left"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{loc:Loc UiShellUsed}" />
                            <Run Text="{Binding CapacityUsedMbText, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" / " />
                            <Run Text="{Binding CapacityMaxMbText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding CapacityLbaText, Mode=OneWay}"
                                   ToolTip="{Binding CapacityLbaText, Mode=OneWay}" />
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 AutomationProperties.Name="{loc:Loc UiShellDiscCapacityUsageMeter}"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding CapacityUsagePercent, Mode=OneWay}"
                                 Foreground="{Binding CurrentCapacity.Status, Converter={StaticResource CapacityStatusToBrushConverter}}" />
                </Grid>

                <!-- Right: Capacity Status Pill -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{Binding CurrentCapacity.Status, Converter={StaticResource CapacityStatusToBrushConverter}}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding CapacityStatusText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Canonical Domain & Legal Notice Watermark -->
                <Button Grid.Column="3"
                        Command="{Binding ShowAboutCommand}"
                        AutomationProperties.Name="{loc:Loc UiShellAboutIgnisDiscOpticalStudioAndLegal}"
                        ToolTip="{Binding LegalBannerNotice}"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Left">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding LegalBannerLine1}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LegalBannerLine2}"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
